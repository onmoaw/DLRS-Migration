<Window x:Class="LandPressDataMigrationDesktopApp.DbPrepWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="{x:Static local:AppConfig.DbPrepWizardTitle}"
        Height="700" Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <!-- Gradient Button Style -->
        <Style x:Key="GradientBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Step Card Style -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <LinearGradientBrush x:Key="BlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#EF4444" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#D946EF" Offset="1"/>
        </LinearGradientBrush>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Step Indicators -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Nav buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🛠 Database Preparation &amp; Compatibility Wizard"
                               Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtDbLabel" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Theme Toggle Button -->
                <Button Grid.Column="1" x:Name="btnThemeToggle" Style="{StaticResource GradientBtn}" Padding="14,6"
                        Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                        BorderThickness="1" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Click="BtnThemeToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,4,0"/>
                        <TextBlock x:Name="txtThemeLabel" Text="Light"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- STEP STRIP -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeInsetBg}" Padding="24,10" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="stepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- STEP 1 -->
                <Border x:Name="stepPanel1" Style="{StaticResource StepCard}" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="Step 1 — Check Current Compatibility Levels"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS1_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Queries sys.databases for every database on the server and shows its numeric compatibility_level along with the corresponding SQL Server version name."/>
                        <Button x:Name="btnCheckCompat"
                                Content="Check Compatibility Levels"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource BlueBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnCheckCompat_Click"/>
                        <DataGrid x:Name="dgCompat"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource ThemeCardBorder}"
                                  RowBackground="{DynamicResource ThemeCardBg}"
                                  AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  MaxHeight="220"
                                  CanUserResizeRows="False"
                                  Margin="0,12,0,0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Database Name"      Binding="{Binding DatabaseName}" Width="200"/>
                                <DataGridTextColumn Header="Compat. Level"      Binding="{Binding CompatLevel}"  Width="120"/>
                                <DataGridTextColumn Header="SQL Server Version" Binding="{Binding SqlVersion}"   Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="lblCheckCompatStatus"
                                   Foreground="#4ADE80" FontSize="12" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2 -->
                <Border x:Name="stepPanel2" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 2 — Change Compatibility Level"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS2_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Sets the compatibility level of the selected database. Level 130 (SQL Server 2016) enables OPENJSON. Level 160 (SQL Server 2022) enables all latest features."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Target Level:" Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbCompatLevel" Width="260" Height="32">
                                <ComboBoxItem Content="130 — SQL Server 2016 (OPENJSON)" IsSelected="True" Tag="130"/>
                                <ComboBoxItem Content="140 — SQL Server 2017" Tag="140"/>
                                <ComboBoxItem Content="150 — SQL Server 2019" Tag="150"/>
                                <ComboBoxItem Content="160 — SQL Server 2022 (Recommended)" Tag="160"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="btnChangeCompat"
                                Content="Apply Compatibility Level"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource GreenBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnChangeCompat_Click"/>
                        <TextBlock x:Name="lblChangeCompatStatus"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#4ADE80" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 3 -->
                <Border x:Name="stepPanel3" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 3 — Add RowId Column to tblLinfo02"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS3_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Adds an INT RowId column to tblLinfo02 (if it does not already exist), then populates it with a sequential row number ordered by UnitCod, KhtNum, OwnrGrp, OwnrNum. This unique identifier is required for the batch update operations."/>
                        <Button x:Name="btnAddRowId"
                                Content="Add RowId Column"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource OrangeBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnAddRowId_Click"/>
                        <TextBlock x:Name="lblAddRowIdStatus"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#4ADE80" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 4 -->
                <Border x:Name="stepPanel4" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 4 — Change KRemark Column Type (tblLinfo01)"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS4_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Alters the KRemark column in tblLinfo01 from legacy TEXT to NVARCHAR(MAX) to support Unicode font characters."/>
                        <Button x:Name="btnChangeKRemark"
                                Content="Alter KRemark to NVARCHAR(MAX)"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource PurpleBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnChangeKRemark_Click"/>
                        <TextBlock x:Name="lblChangeKRemarkStatus"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#4ADE80" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 5 -->
                <Border x:Name="stepPanel5" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 5 — Expand Address Column Lengths (tblLinfo02)"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS5_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Alters the name and address columns in tblLinfo02 to NVARCHAR(150) to support Unicode text after font conversion."/>
                        <Button x:Name="btnExpandAddrs"
                                Content="Expand Address Columns to NVARCHAR(150)"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource BlueBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnExpandAddrs_Click"/>
                        <TextBlock x:Name="lblExpandAddrsStatus"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#4ADE80" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 6 -->
                <Border x:Name="stepPanel6" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Step 6 — Add Conversion Status Column (convsts)"
                                   Foreground="#38BDF8" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtS6_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,12"
                                   Text="Adds an NVARCHAR(20) column named convsts to tblHalsabek, tblLinfo01 and tblLinfo02 to track font conversion status."/>
                        <Button x:Name="btnAddConvsts"
                                Content="Add convsts Column to All Three Tables"
                                Style="{StaticResource GradientBtn}"
                                Background="{StaticResource GreenBrush}"
                                HorizontalAlignment="Left"
                                Click="BtnAddConvsts_Click"/>
                        <TextBlock x:Name="lblAddConvstsStatus"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"
                                   Foreground="#4ADE80" Visibility="Collapsed"/>
                        <!-- DONE banner -->
                        <Border x:Name="doneBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource ThemeSuccessBg}"
                                BorderBrush="{DynamicResource ThemeSuccessBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="🎉 All preparation steps completed!"
                                           Foreground="{DynamicResource ThemeSuccessText}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Your database is now verified and ready for font conversion and data migration."
                                           Foreground="{DynamicResource ThemeSuccessText}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- NAV BUTTONS -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeHeaderBg}" Padding="24,12" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStepCounter"
                           Grid.Column="0"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="Step 1 of 6"/>

                <Button x:Name="btnPrev"
                        Grid.Column="1"
                        Content="Previous"
                        Style="{StaticResource GradientBtn}"
                        IsEnabled="False"
                        Margin="0,0,10,0"
                        Click="BtnPrev_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#374151"/>
                    </Button.Background>
                </Button>

                <Button x:Name="btnNext"
                        Grid.Column="2"
                        Content="Next"
                        Style="{StaticResource GradientBtn}"
                        Margin="0,0,10,0"
                        Click="BtnNext_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button x:Name="btnClose"
                        Grid.Column="3"
                        Content="Close"
                        Style="{StaticResource GradientBtn}"
                        Click="BtnClose_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#7F1D1D"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="{DynamicResource ThemeFooterBg}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:AppConfig.DbPrepWizardTitle}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Powered by " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                    <TextBlock Text="Pirthe Limited" Foreground="#F97316" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="© 2026 Pirthe Limited" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
