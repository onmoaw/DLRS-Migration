<Window x:Class="LandPressDataMigrationDesktopApp.MigratedUnitsSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Data Migration Summary — Migrated Unit Codes"
        Height="660" Width="920"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Summary Stat Cards -->
            <RowDefinition Height="*"/>    <!-- DataGrid of Migrated Unit Codes -->
            <RowDefinition Height="Auto"/> <!-- Status Note / Loading -->
            <RowDefinition Height="Auto"/> <!-- Bottom Action Bar with OK button -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="22,14" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="/Assets/DLRS-Migration App Icon.png" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎉 Data Migration Completed" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="21" FontWeight="Bold"/>
                            <Border Background="#059669" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SUCCESS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="txtDbInfo" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,4,0,0"
                                   Text="Source Database: sylhet371  •  Core Target: [DLRSLSINF_4103PRSDB]"/>
                    </StackPanel>
                </StackPanel>

                <!-- Theme Toggle Button -->
                <Button x:Name="btnThemeToggle" Grid.Column="1" VerticalAlignment="Center" Padding="12,6"
                        Style="{StaticResource DialogBtn}" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,5,0" FontSize="12"/>
                        <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- STATS CARDS -->
        <Border Grid.Row="1" Padding="18,12" Background="{DynamicResource ThemeInsetBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Units Count -->
                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="MIGRATED UNITS" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalUnits" Text="0" Foreground="#38BDF8" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Khatians Count -->
                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="4,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL KHATIANS" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalKhatians" Text="0" Foreground="#34D399" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Plots Count -->
                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="4,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL PLOTS" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalPlots" Text="0" Foreground="#A78BFA" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Owners Count -->
                <Border Grid.Column="3" Style="{StaticResource StatCard}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL OWNERS" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotalOwners" Text="0" Foreground="#FBBF24" FontSize="26" FontWeight="Bold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DATA GRID OF MIGRATED UNIT CODES -->
        <Border Grid.Row="2" Margin="18,8,18,6" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="dgMigratedUnits"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                          Foreground="{DynamicResource ThemeTextPrimary}"
                          BorderThickness="0"
                          FontSize="13"
                          RowHeight="36">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource ThemeInsetBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SlNo}" Width="50"/>
                        <DataGridTextColumn Header="Unit Code (Mouza)" Binding="{Binding UnitCode}" Width="150" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Mouza Name" Binding="{Binding MouzaName}" Width="160"/>
                        <DataGridTextColumn Header="Khatians" Binding="{Binding FormattedKhatians}" Width="100"/>
                        <DataGridTextColumn Header="Plots (Linfo01)" Binding="{Binding FormattedPlots}" Width="110"/>
                        <DataGridTextColumn Header="Owners (Linfo02)" Binding="{Binding FormattedOwners}" Width="110"/>
                        <DataGridTemplateColumn Header="Status" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#064E3B" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="#6EE7B7" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading / Empty Overlay -->
                <TextBlock x:Name="txtLoading" Text="Loading migrated unit codes..." Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- STATUS NOTE -->
        <Border Grid.Row="3" Margin="18,0,18,6" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" Foreground="{DynamicResource ThemeSuccessText}" FontWeight="Bold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="These unit codes and records have been committed to the core database [DLRSLSINF_4103PRSDB]. Click OK to proceed."
                           Foreground="{DynamicResource ThemeSuccessText}" FontSize="12.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- BOTTOM ACTION BAR WITH OK BUTTON -->
        <Border Grid.Row="4" Padding="20,12" Background="{DynamicResource ThemeFooterBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Click OK to return and continue with other conversions or migrations."
                           Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" VerticalAlignment="Center"/>

                <Button x:Name="btnOk" Grid.Column="1" Width="180" MinHeight="42" Style="{StaticResource DialogBtn}" IsDefault="True" Click="BtnOk_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✔" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="OK — Continue" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
