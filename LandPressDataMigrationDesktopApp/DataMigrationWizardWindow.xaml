<Window x:Class="LandPressDataMigrationDesktopApp.DataMigrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="{x:Static local:AppConfig.MigrationWizardTitle}"
        Height="800" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="WizardBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Input Box Style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <LinearGradientBrush x:Key="BlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Source DB (Read-Only) & Global Config -->
            <RowDefinition Height="Auto"/>
            <!-- Step Indicators & Overall Progress -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Navigation -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="24,14" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtWizardTitle" Text="🚀 Core Data Migration Wizard" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                        <Border x:Name="badgeSpName" Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SP_LIS_DATA_MIGRATION" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtDbLabel" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" Margin="0,3,0,0"
                               Text="Target Server Database: [DLRSLSINF_4103PRSDB]"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel x:Name="panelComCod" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Company Code: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="4103" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- Theme Toggle Button -->
                    <Button x:Name="btnThemeToggle" Style="{StaticResource WizardBtn}" Padding="14,6"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                            BorderThickness="1" Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SOURCE DB READ-ONLY DISPLAY & RS CONFIG STRIP -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeInsetBg}" Padding="24,9" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Selected Source Database (Strictly Read-Only) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="Source Database: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSourceDbDisplay" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text=" (Locked Source)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Default RS / Session Number (Hidden for normal User) -->
                <StackPanel x:Name="panelGlobalDesc02" Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="RS / Session Number (@Desc02): " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtGlobalDesc02" Text="201901" Width="95" Height="28" Style="{StaticResource InputBox}"
                             TextChanged="TxtGlobalDesc02_TextChanged" ToolTip="Settlement Register Number (applied to LINFO00, LINFO01, LINFO02)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STEP STRIP & OVERALL PROGRESS -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeHeaderBg}" Padding="20,10" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel x:Name="stepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <!-- Overall Wizard Progress Bar -->
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="pbWizardOverall" Height="4" Minimum="0" Maximum="7" Value="0"
                                 Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" BorderThickness="0"/>
                    <TextBlock x:Name="lblWizardOverallPct" Grid.Column="1" Text="0% complete" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- SCROLLABLE STEP CONTENT -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- GLOBAL COMPLETION BANNER -->
                <Border x:Name="doneBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource ThemeSuccessBg}"
                        BorderBrush="{DynamicResource ThemeSuccessBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎉" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Data Migration Completed Successfully!"
                                           Foreground="{DynamicResource ThemeSuccessText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Core Khatians, Plots, and Owners data have been migrated and committed to [DLRSLSINF_4103PRSDB]."
                                       Foreground="{DynamicResource ThemeSuccessText}" FontSize="12" Margin="26,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnViewMigratedUnitsInWizard" Content="📋 View Migrated Units Report"
                                    Padding="14,8" Style="{StaticResource WizardBtn}" Click="BtnViewMigratedUnits_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#059669" Offset="0"/>
                                        <GradientStop Color="#047857" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 1: MTO_AREAINF (Optional) -->
                <Border x:Name="stepPanel1" Style="{StaticResource StepCard}" Visibility="Visible">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS1_Title" Text="Step 1 — Migrate Land Info to AREAINF" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#164E63" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Optional — Can Skip" Foreground="#67E8F9" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS1_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_AREAINF', @Desc01='[SourceDB]'. Migrates area hierarchy from source database to AREAINF."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="txtS1_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunS1" Content="Execute MTO_AREAINF" Style="{StaticResource WizardBtn}"
                                    Background="{StaticResource GreenBrush}" Click="BtnRunS1_Click"/>
                            <Button x:Name="btnSkipS1" Content="Skip This Step" Style="{StaticResource WizardBtn}" Background="#475569"
                                    Margin="10,0,0,0" Click="BtnSkipCurrent_Click"/>
                        </StackPanel>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS1" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS1" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS1Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 2: MANAGE_MISSMATCH (Optional) -->
                <Border x:Name="stepPanel2" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS2_Title" Text="Step 2 — Manage Mismatched Khatians" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#164E63" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Optional — Can Skip" Foreground="#67E8F9" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS2_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MANAGE_MISSMATCH', @Desc01='[SourceDB]'. Compares tblLinfo01, tblLinfo02, and tblHalsabek to detect mismatching Khatians."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="txtS2_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunS2" Content="Execute MANAGE_MISSMATCH" Style="{StaticResource WizardBtn}"
                                    Background="{StaticResource GreenBrush}" Click="BtnRunS2_Click"/>
                            <Button x:Name="btnSkipS2" Content="Skip This Step" Style="{StaticResource WizardBtn}" Background="#475569"
                                    Margin="10,0,0,0" Click="BtnSkipCurrent_Click"/>
                        </StackPanel>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS2" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS2" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS2Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>

                        <!-- Mismatch results grid -->
                        <DataGrid x:Name="dgMismatch"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  Foreground="{DynamicResource ThemeTextPrimary}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource ThemeCardBorder}"
                                  RowBackground="{DynamicResource ThemeCardBg}"
                                  AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  MaxHeight="200"
                                  CanUserResizeRows="False"
                                  Margin="0,12,0,0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- STEP 3: MTO_LINFO00 (Required) -->
                <Border x:Name="stepPanel3" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS3_Title" Text="Step 3 — Migrate Land Info to LINFO00" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#881337" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="★ Required (Must Complete)" Foreground="#FDA4AF" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS3_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_LINFO00', @Desc01='[SourceDB]', @Desc02='[RS Number]'. Migrates Khatian master records into dbo_lis.linfo00, updates source convsts to 'SUCCESS', and logs any mismatched items."/>

                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="txtS3_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="panelS3_Desc02" Orientation="Horizontal">
                                <TextBlock Text="RS Number:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <TextBox x:Name="txtS3_Desc02" Text="201901" Width="160" Height="32" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="btnRunS3" Content="Execute MTO_LINFO00" Style="{StaticResource WizardBtn}"
                                Background="{StaticResource BlueBrush}" HorizontalAlignment="Left" Click="BtnRunS3_Click"/>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS3" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#3B82F6" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS3" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS3Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 4: MTO_LINFO01 (Required) -->
                <Border x:Name="stepPanel4" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS4_Title" Text="Step 4 — Migrate Land Info to LINFO01" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#881337" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="★ Required (Must Complete)" Foreground="#FDA4AF" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS4_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_LINFO01', @Desc01='[SourceDB]', @Desc02='[RS Number]'. Aggregates Halsabek plots, merges area and remarks from tblLinfo01, checks duplicates, inserts into dbo_lis.LINFO01, and updates convsts in source DB."/>

                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="txtS4_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="panelS4_Desc02" Orientation="Horizontal">
                                <TextBlock Text="RS Number:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <TextBox x:Name="txtS4_Desc02" Text="201901" Width="160" Height="32" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="btnRunS4" Content="Execute MTO_LINFO01" Style="{StaticResource WizardBtn}"
                                Background="{StaticResource BlueBrush}" HorizontalAlignment="Left" Click="BtnRunS4_Click"/>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS4" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#3B82F6" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS4" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS4Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 5: MTO_LINFO02 (Required) -->
                <Border x:Name="stepPanel5" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS5_Title" Text="Step 5 — Migrate Land Info to LINFO02" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#881337" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="★ Required (Must Complete)" Foreground="#FDA4AF" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS5_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_LINFO02', @Desc01='[SourceDB]', @Desc02='[RS Number]'. Extracts owner relations, gender, father/spouse name from address fields, deduplicates, inserts into dbo_lis.linfo02, and updates convsts to 'SUCCESS'."/>

                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="txtS5_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="panelS5_Desc02" Orientation="Horizontal">
                                <TextBlock Text="RS Number:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <TextBox x:Name="txtS5_Desc02" Text="201901" Width="160" Height="32" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="btnRunS5" Content="Execute MTO_LINFO02" Style="{StaticResource WizardBtn}"
                                Background="{StaticResource BlueBrush}" HorizontalAlignment="Left" Click="BtnRunS5_Click"/>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS5" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#3B82F6" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS5" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS5Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 6: UPDTMAPINF01 (Optional) -->
                <Border x:Name="stepPanel6" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS6_Title" Text="Step 6 — Update Map Information (UPDTMAPINF01)" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#164E63" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Optional — Can Skip" Foreground="#67E8F9" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS6_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ProcID='UPDTMAPINF01', @Desc01='[SourceDB]'. Inserts distinct unit codes from tblHalsabek into [dbo_lis].[mapinf01] for sheet '000'."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="txtS6_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunS6" Content="Execute UPDTMAPINF01" Style="{StaticResource WizardBtn}"
                                    Background="{StaticResource GreenBrush}" Click="BtnRunS6_Click"/>
                            <Button x:Name="btnSkipS6" Content="Skip This Step" Style="{StaticResource WizardBtn}" Background="#475569"
                                    Margin="10,0,0,0" Click="BtnSkipCurrent_Click"/>
                        </StackPanel>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS6" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS6" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS6Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- STEP 7: MTO_PLOTINF01 (Optional) -->
                <Border x:Name="stepPanel7" Style="{StaticResource StepCard}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtS7_Title" Text="Step 7 — Migrate Land Info to PLOTINF01" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"/>
                                <Border Background="#78350F" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Optional / In Progress — Can Skip" Foreground="#FDE68A" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="txtS7_Desc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,14"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_PLOTINF01', @Desc01='[SourceDB]', @Desc02='[RS Number]'. Migrates plot records into dbo_lis.plotinf01."/>

                        <StackPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Source DB:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="txtS7_Desc01" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="panelS7_Desc02" Orientation="Horizontal">
                                <TextBlock Text="RS Number:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Width="90"/>
                                <TextBox x:Name="txtS7_Desc02" Text="201901" Width="160" Height="32" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunS7" Content="Execute MTO_PLOTINF01" Style="{StaticResource WizardBtn}"
                                    Background="{StaticResource GreenBrush}" Click="BtnRunS7_Click"/>
                            <Button x:Name="btnSkipS7" Content="Skip This Step" Style="{StaticResource WizardBtn}" Background="#475569"
                                    Margin="10,0,0,0" Click="BtnSkipCurrent_Click"/>
                        </StackPanel>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunningS7" Visibility="Collapsed" Margin="0,12,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblTimerS7" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="12"/>
                        </StackPanel>

                        <TextBlock x:Name="lblS7Status" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- NAV BAR -->
        <Border Grid.Row="4" Background="{DynamicResource ThemeHeaderBg}" Padding="24,12" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStepCounter"
                           Grid.Column="0"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="Step 1 of 7"/>

                <Button x:Name="btnPrev"
                        Grid.Column="1"
                        Content="Previous"
                        Style="{StaticResource WizardBtn}"
                        IsEnabled="False"
                        Margin="0,0,10,0"
                        Click="BtnPrev_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#374151"/>
                    </Button.Background>
                </Button>

                <Button x:Name="btnSkip"
                        Grid.Column="2"
                        Content="Skip Step"
                        Style="{StaticResource WizardBtn}"
                        Margin="0,0,10,0"
                        Click="BtnSkipCurrent_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#4B5563"/>
                    </Button.Background>
                </Button>

                <Button x:Name="btnNext"
                        Grid.Column="3"
                        Content="Next"
                        Style="{StaticResource WizardBtn}"
                        Margin="0,0,10,0"
                        Click="BtnNext_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button x:Name="btnClose"
                        Grid.Column="4"
                        Content="Close"
                        Style="{StaticResource WizardBtn}"
                        Click="BtnClose_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#7F1D1D"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="5" Background="{DynamicResource ThemeFooterBg}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static local:AppConfig.MigrationWizardTitle}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Powered by " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                    <TextBlock Text="Pirthe Limited" Foreground="#F97316" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="© 2026 Pirthe Limited" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
