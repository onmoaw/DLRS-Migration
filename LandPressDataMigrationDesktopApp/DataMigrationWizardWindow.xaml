<Window x:Class="LandPressDataMigrationDesktopApp.DataMigrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="{x:Static local:AppConfig.MigrationWizardTitle}"
        Height="840" Width="1080"
        MinHeight="720" MinWidth="940"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Segoe UI, Kalpurush, Vrinda, Arial"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="WizardBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Input Box Style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <LinearGradientBrush x:Key="BlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AmberBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F59E0B" Offset="0"/>
            <GradientStop Color="#D97706" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header with Top-Right Mode Control -->
            <RowDefinition Height="Auto"/> <!-- 1: Staging Source DB & Global Config -->
            <RowDefinition Height="Auto"/> <!-- 2: Step Indicators & Progress Strip -->
            <RowDefinition Height="Auto"/> <!-- 3: Auto-Run Control Bar (When in Auto mode) -->
            <RowDefinition Height="*"/>    <!-- 4: Active Step Content -->
            <RowDefinition Height="Auto"/> <!-- 5: Navigation Bar -->
            <RowDefinition Height="Auto"/> <!-- 6: Footer -->
        </Grid.RowDefinitions>

        <!-- 0: HEADER WITH TOP-RIGHT MODE CONTROL -->
        <Border Grid.Row="0" Padding="24,12" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtWizardTitle" Text="🚀 Core Data Migration Pipeline" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="19" FontWeight="Bold"/>
                        <Border Background="#3B82F6" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Sequential Pipeline" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtDbLabel" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0"
                               Text="Target Server Database: [DLRSLSINF_4103PRSDB]"/>
                </StackPanel>

                <!-- Right: Control Option for Auto vs Manual Execution (Top Right Corner) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Mode Switcher Control -->
                    <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Execution Mode: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <RadioButton x:Name="rbModeAuto" Content="⚡ Auto-Run (All in Sequence)" IsChecked="True" Foreground="#10B981" FontWeight="Bold" FontSize="12" Margin="6,0,10,0" Checked="Mode_Changed"/>
                            <RadioButton x:Name="rbModeManual" Content="🖐 Manual (Step-by-Step)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Checked="Mode_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Company Code (Admin view) -->
                    <StackPanel x:Name="panelComCod" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Company: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                            <TextBlock Text="4103" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <!-- View Records Button -->
                    <Button x:Name="btnViewRecords" Style="{StaticResource WizardBtn}" Padding="12,5" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="#0D9488" BorderThickness="1.5"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnViewRecords_Click"
                            ToolTip="Open Land Records Search and Viewer.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔎" Margin="0,0,4,0"/>
                            <TextBlock Text="View Records" FontWeight="Bold" Foreground="#0D9488"/>
                        </StackPanel>
                    </Button>

                    <!-- Theme Toggle Button -->
                    <Button x:Name="btnThemeToggle" Style="{StaticResource WizardBtn}" Padding="12,5"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                            BorderThickness="1" Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,4,0"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: STAGING SOURCE & GLOBAL CONFIG STRIP -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeInsetBg}" Padding="24,8" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Staging Source DB (Strictly Read-Only) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="Staging Source DB: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSourceDbDisplay" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text=" (Locked Staging Source)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Global RS Number -->
                <StackPanel x:Name="panelGlobalDesc02" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1">
                    <TextBlock Text="Default RS / Session Number (@Desc02): " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtGlobalDesc02" Text="201901" Width="95" Height="28" Style="{StaticResource InputBox}"
                             TextChanged="TxtGlobalDesc02_TextChanged" ToolTip="Settlement Register Number (applied to Khatian and Plot migration steps)"/>
                </StackPanel>

                <!-- Right: SP Verification Helper -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="btnDeploySp" Content="🛠 Verify Stored Procedures in DB"
                            Style="{StaticResource WizardBtn}" Padding="12,5" FontSize="11"
                            Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}"
                            ToolTip="Checks target database [DLRSLSINF_4103PRSDB] for all stored procedures and compiles or updates them from DevResource scripts if needed."
                            Click="BtnDeploySp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: STEP INDICATORS & OVERALL PROGRESS -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeHeaderBg}" Padding="20,10" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1">
            <StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="stepIndicatorPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                </ScrollViewer>
                <!-- Overall Wizard Progress Bar -->
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="pbWizardOverall" Height="4" Minimum="0" Maximum="8" Value="0"
                                 Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" BorderThickness="0"/>
                    <TextBlock x:Name="lblWizardOverallPct" Grid.Column="1" Text="0% complete" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3: AUTO-RUN CONTROL BAR (Visible in Auto Mode) -->
        <Border x:Name="panelAutoRunControl" Grid.Row="3" Background="{DynamicResource ThemeCardBg}" Padding="24,10" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Button x:Name="btnStartAuto" Content="▶ Start Auto Migration (Run All Steps)" Style="{StaticResource WizardBtn}"
                            Background="{StaticResource GreenBrush}" Padding="20,10" FontSize="14" FontWeight="Bold" Click="BtnStartAuto_Click"/>

                    <Button x:Name="btnPauseAuto" Content="⏸ Pause Auto-Run" Style="{StaticResource WizardBtn}"
                            Background="{StaticResource AmberBrush}" Padding="16,10" FontSize="14" Margin="10,0,0,0" Visibility="Collapsed" Click="BtnPauseAuto_Click"/>

                    <Button x:Name="btnStopAuto" Content="⏹ Stop" Style="{StaticResource WizardBtn}"
                            Background="#7F1D1D" Padding="16,10" FontSize="14" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnStopAuto_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="lblAutoStatus" Text="Ready to execute all steps sequentially." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ThemeInsetBg}" CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="lblOverallTimer" Text="Total Elapsed: 00:00" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4: SCROLLABLE ACTIVE STEP CONTENT -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>

                <!-- GLOBAL COMPLETION BANNER -->
                <Border x:Name="doneBanner"
                        Visibility="Collapsed"
                        Background="{DynamicResource ThemeSuccessBg}"
                        BorderBrush="{DynamicResource ThemeSuccessBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18,14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎉" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Sequential Data Migration Completed Successfully!"
                                           Foreground="{DynamicResource ThemeSuccessText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Core Khatians, Plots, and Owners data have been migrated and committed to [DLRSLSINF_4103PRSDB]."
                                       Foreground="{DynamicResource ThemeSuccessText}" FontSize="12" Margin="26,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnViewMigratedUnitsInWizard" Content="📋 View Migrated Units Report"
                                    Padding="14,8" Style="{StaticResource WizardBtn}" Click="BtnViewMigratedUnits_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#059669" Offset="0"/>
                                        <GradientStop Color="#047857" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ACTIVE STEP CARD -->
                <Border x:Name="activeStepCard" Style="{StaticResource StepCard}" Visibility="Visible">
                    <StackPanel>
                        <!-- Step Title & Badges -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtStepTitle" Text="Step 1 — Prepare Area Information" Foreground="#38BDF8" FontSize="19" FontWeight="Bold"/>
                                <Border x:Name="bdStepType" Background="#164E63" CornerRadius="4" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtStepType" Text="Optional — Can Skip" Foreground="#67E8F9" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock x:Name="txtStepProcBadge" Text="SP_LIS_DATA_MIGRATION · @ProcID='MTO_AREAINF'" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <!-- Step Description -->
                        <TextBlock x:Name="txtStepDesc" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" LineHeight="21" Margin="0,0,0,16"
                                   Text="Executes: SP_LIS_DATA_MIGRATION @ComCod='4103', @ProcID='MTO_AREAINF', @Desc01='[SourceDB]'. Migrates area hierarchy from source database to AREAINF."/>

                        <!-- Parameters Panel -->
                        <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Execution Parameters:" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target Stored Proc:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParamTargetProc" Grid.Column="1" Text="dbo.SP_LIS_DATA_MIGRATION" Foreground="#38BDF8" FontSize="13.5" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Process ID (@ProcID):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParamProcId" Grid.Column="1" Text="MTO_AREAINF" Foreground="#A78BFA" FontSize="13.5" FontWeight="Bold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Database (@Desc01):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtParamDesc01" Grid.Column="1" Text="DLRS_Migration_Intrm" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- RS Number Input (Shown if step uses @Desc02) -->
                                <Grid x:Name="panelParamRs" Margin="0,2,0,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RS Number (@Desc02):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                                        <TextBox x:Name="txtStepRsNumber" Text="201901" Width="140" Height="30" FontSize="13.5" Style="{StaticResource InputBox}"/>
                                        <TextBlock Text="(Applied to target khatian/plot tables)" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Execution Buttons (Shown in Manual Mode) -->
                        <StackPanel x:Name="panelManualActions" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="btnExecuteStep" Content="Execute MTO_AREAINF" Style="{StaticResource WizardBtn}"
                                    Background="{StaticResource GreenBrush}" Padding="20,10" FontSize="14" FontWeight="Bold" Click="BtnExecuteStep_Click"/>
                            <Button x:Name="btnSkipCurrentStep" Content="Skip This Step" Style="{StaticResource WizardBtn}" Background="#475569"
                                    Margin="12,0,0,0" Padding="18,10" FontSize="13.5" Click="BtnSkipCurrent_Click"/>
                        </StackPanel>

                        <!-- Live Progress & Timer -->
                        <StackPanel x:Name="panelRunning" Visibility="Collapsed" Margin="0,14,0,0">
                            <ProgressBar IsIndeterminate="True" Height="5" Background="{DynamicResource ThemeInsetBg}" Foreground="#10B981" Margin="0,0,0,8"/>
                            <TextBlock x:Name="lblTimer" Text="⏳ Executing on SQL Server... Elapsed: 00:00" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Status Notification Alert -->
                        <Border x:Name="bdStatusAlert" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="8" Padding="16,12"
                                Background="{DynamicResource ThemeInsetBg}" BorderThickness="1.5" BorderBrush="{DynamicResource ThemeCardBorder}">
                            <TextBlock x:Name="lblStatus" TextWrapping="Wrap" FontSize="14.5" LineHeight="22" FontWeight="SemiBold"/>
                        </Border>

                        <!-- Results DataGrid Container -->
                        <StackPanel x:Name="panelResultsGrid" Visibility="Collapsed" Margin="0,16,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="lblResultHeader" Text="📊 Result Records" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock x:Name="lblResultCount" Grid.Column="1" Text="0 records returned" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12.5"/>
                            </Grid>

                            <DataGrid x:Name="dgResults"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      Foreground="{DynamicResource ThemeTextPrimary}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource ThemeCardBorder}"
                                      RowBackground="{DynamicResource ThemeCardBg}"
                                      AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      FontSize="12.5"
                                      MaxHeight="260"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="True">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                            </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 5: NAV BAR -->
        <Border Grid.Row="5" Background="{DynamicResource ThemeHeaderBg}" Padding="24,12" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStepCounter"
                           Grid.Column="0"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           VerticalAlignment="Center"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Text="Step 1 of 8"/>

                <Button x:Name="btnPrev"
                        Grid.Column="1"
                        Content="Previous"
                        Style="{StaticResource WizardBtn}"
                        IsEnabled="False"
                        MinHeight="38"
                        FontSize="13.5"
                        Margin="0,0,10,0"
                        Click="BtnPrev_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#374151"/>
                    </Button.Background>
                </Button>

                <Button x:Name="btnSkip"
                        Grid.Column="2"
                        Content="Skip Step"
                        Style="{StaticResource WizardBtn}"
                        MinHeight="38"
                        FontSize="13.5"
                        Margin="0,0,10,0"
                        Click="BtnSkipCurrent_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#4B5563"/>
                    </Button.Background>
                </Button>

                <Button x:Name="btnNext"
                        Grid.Column="3"
                        Content="Next"
                        Style="{StaticResource WizardBtn}"
                        MinHeight="38"
                        FontSize="13.5"
                        Margin="0,0,10,0"
                        Click="BtnNext_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#8B5CF6" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <Button x:Name="btnClose"
                        Grid.Column="4"
                        Content="Close"
                        Style="{StaticResource WizardBtn}"
                        MinHeight="38"
                        FontSize="13.5"
                        Click="BtnClose_Click">
                    <Button.Background>
                        <SolidColorBrush Color="#7F1D1D"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Border>

        <!-- 6: FOOTER -->
        <Border Grid.Row="6" Background="{DynamicResource ThemeFooterBg}" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
