<Window x:Class="LandPressDataMigrationDesktopApp.PipelineAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        Title="Pipeline Notification"
        Height="500" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Segoe UI, Kalpurush, Vrinda, Arial"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="bdIcon" Width="52" Height="52" CornerRadius="26" Background="#7F1D1D" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="txtIcon" Text="⚠️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtAlertTitle" Text="Migration Pipeline Alert" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="21" FontWeight="Bold"/>
                <TextBlock x:Name="txtStepName" Text="Step: Font Conversion &amp; Database Update" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Content & Details -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="txtUserMessage" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,14"
                               Text="An error occurred while executing the migration step. You can choose to retry this step, skip it if non-critical, or abort the entire pipeline."/>

                    <TextBlock Text="Technical Details:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas, Segoe UI" FontSize="12.5" Height="140"
                             Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="10"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnAbort" Grid.Column="1" Content="🛑 Abort Pipeline" Style="{StaticResource DialogBtn}" Background="#7F1D1D" Margin="0,0,10,0" Click="BtnAbort_Click"/>
            <Button x:Name="btnSkip" Grid.Column="2" Content="⏭ Skip Step" Style="{StaticResource DialogBtn}" Background="#475569" Margin="0,0,10,0" Click="BtnSkip_Click"/>
            <Button x:Name="btnRetry" Grid.Column="3" Content="🔄 Retry Step" Style="{StaticResource DialogBtn}" Background="#0284C7" Click="BtnRetry_Click"/>
        </Grid>
    </Grid>
</Window>
