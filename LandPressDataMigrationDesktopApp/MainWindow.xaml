<Window x:Class="LandPressDataMigrationDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="{x:Static local:AppConfig.WindowTitle}" Height="940" Width="1440"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/DLRS-Migration App Icon.png"
        FontFamily="{StaticResource AppFontPrimary}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <!-- Stage Card Style -->
        <Style x:Key="StageCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Input Box Style -->
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Rounded Gradient Button -->
        <Style x:Key="AppBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#64748B"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ================= FOOTER ================= -->
        <Border DockPanel.Dock="Bottom" Padding="18,8" Background="{DynamicResource ThemeFooterBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                           Text="{x:Static local:AppConfig.AppTitleWithVersion}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Text="Powered by "/>
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F97316" Text="Pirthe Limited"/>
                </StackPanel>

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                           Text="© 2026 Pirthe Limited. All rights reserved."/>
            </Grid>
        </Border>

        <!-- ================= TOP APP BAR (BRANDING, USER ROLE, THEME TOGGLE) ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Title and Role Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Image Source="/Assets/DLRS-Migration App Icon.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static local:AppConfig.AppName}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1D4ED8" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static local:AppConfig.Version}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="borderUserRoleBadge" Background="#065F46" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtUserRoleBadge" Text="👤 Admin (Full Access)" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right: Mode Control Toggle, Log Viewer, Theme Toggle Button -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <!-- Top-Right Corner Manual / Auto Control Button -->
                    <Button x:Name="btnToggleControlMode" Style="{StaticResource AppBtn}" Padding="12,6" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeInsetBg}" BorderBrush="#3B82F6" BorderThickness="1.5"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnToggleControlMode_Click"
                            ToolTip="Click to toggle between 1-Click Automated Pipeline and Manual Step-by-Step Execution.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtControlModeIcon" Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtControlModeText" Text="Auto Execution (Default)" FontSize="12" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- View Pipeline & Mapping Logs Button -->
                    <Button x:Name="btnOpenPipelineLogs" Style="{StaticResource AppBtn}" Padding="10,6" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnOpenPipelineLogs_Click"
                            ToolTip="Open live Pipeline Execution &amp; Value Mapping Logs viewer.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Logs" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- View Records Search & Filter Screen Button -->
                    <Button x:Name="btnViewRecords" Style="{StaticResource AppBtn}" Padding="12,6" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="#0D9488" BorderThickness="1.5"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnViewRecords_Click"
                            ToolTip="Open Land Records Search and Viewer.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔎" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="View Records" FontSize="12.5" FontWeight="Bold" Foreground="#0D9488" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnThemeToggle" Style="{StaticResource AppBtn}" Padding="12,6"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                            BorderThickness="1" Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKFLOW CONTENT (2-COLUMN PIPELINE: FULL HEIGHT LEFT + STEPS RIGHT) ================= -->
        <Grid Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/>
                <!-- Left: Server Connection, Intermediate DB Guard, Source DB Selection -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Sequential Step Panels (Step 1, Step 2, Step 3) -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>

                    <!-- ================= SERVER & DATABASE SELECTION CARD ================= -->
                    <Border Style="{StaticResource StageCard}" BorderBrush="#3B82F6" BorderThickness="1.5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#1D4ED8" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                    <TextBlock Text="PREPARATION" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Server &amp; Source DB Selection" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15.5"/>
                            </StackPanel>

                            <!-- Server & Auth Bar -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                                <TextBox x:Name="txtServer" Grid.Column="1" Style="{StaticResource InputBox}" Height="30" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="Auth:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="13"/>
                                <ComboBox x:Name="cmbAuth" Grid.Column="3" Width="95" Height="30" FontSize="12.5" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}">
                                    <ComboBoxItem Content="Windows"/>
                                    <ComboBoxItem Content="SQL"/>
                                </ComboBox>
                            </Grid>

                            <!-- SQL User/Password (if SQL Auth selected) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="txtUser" Width="140" Margin="0,0,6,0" Style="{StaticResource InputBox}" Height="30" FontSize="13" Visibility="Collapsed"/>
                                <PasswordBox x:Name="txtPassword" Width="140" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}" Height="30" FontSize="13" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Connect Button & Status -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Connect" Width="105" Height="34" Padding="14,6" Style="{StaticResource AppBtn}" FontSize="13" FontWeight="Bold" Click="Connect_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <TextBlock x:Name="txtConnectError" Visibility="Collapsed" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Server Status Indicator Banner -->
                            <Border x:Name="borderServerConnectedBadge" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Server Status: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtServerStatusSummary" Text="⚪ Disconnected — Enter server &amp; click Connect" Foreground="#F59E0B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Permanent Intermediate Database Guard Banner -->
                            <Border x:Name="borderIntrmDbCard" Background="{DynamicResource ThemeInsetBg}" BorderBrush="#0D9488" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Intermediate DB: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtIntrmDbStatus" Text="⚪ Waiting for Server Connection" Foreground="#F59E0B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Action Buttons: Migration Logs & Create/Repair DLRS_Migration_Intrm -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- View Migration Logs Button -->
                                            <Button x:Name="btnViewIntrmLogs" Visibility="Collapsed"
                                                    Style="{StaticResource AppBtn}" Padding="10,5" MinHeight="28" FontSize="12" FontWeight="SemiBold"
                                                    Margin="0,0,6,0" Click="BtnViewIntrmLogs_Click">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                                        <GradientStop Color="#1D4ED8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                                <TextBlock Text="📜 Logs" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Create or Repair Button -->
                                            <Button x:Name="btnCreateOrRepairIntrmDb" Visibility="Collapsed"
                                                    Style="{StaticResource AppBtn}" Padding="12,5" MinHeight="28" FontSize="12" FontWeight="Bold"
                                                    Click="BtnCreateOrRepairIntrmDb_Click">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0D9488" Offset="0"/>
                                                        <GradientStop Color="#0F766E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                                <TextBlock x:Name="txtBtnCreateIntrmDb" Text="⚡ Create DB" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Detail / Explanation / Error Message -->
                                    <TextBlock x:Name="txtIntrmDbDetail" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>

                                    <!-- Loading Progress Bar -->
                                    <ProgressBar x:Name="pbIntrmDbAction" Height="6" Minimum="0" Maximum="100" IsIndeterminate="True"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#0D9488" BorderThickness="0"
                                                 Visibility="Collapsed" Margin="0,6,0,2"/>
                                </StackPanel>
                            </Border>

                            <!-- Access Blocked Notice Banner -->
                            <Border x:Name="borderIntrmBlockedNotice" Visibility="Collapsed" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⛔" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtIntrmBlockedReason" Text="Access blocked: You must create/validate DLRS_Migration_Intrm before proceeding." Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Databases List -->
                            <TextBlock Text="Available Source Databases (click to select):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ListBox x:Name="lstDatabases" Height="140" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}" FontSize="13"
                                     SelectionChanged="Databases_SelectionChanged"/>

                            <!-- Active Database Banner -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active Source DB: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtActiveDbName" Text="(None Selected)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Unit Code Already Migrated Pre-Check Warning Banner -->
                            <Border x:Name="borderAlreadyMigratedNotice" Visibility="Collapsed" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="6" Padding="12,9" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="⛔" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PRE-CHECK: UNIT ALREADY MIGRATED" Foreground="#FCA5A5" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtAlreadyMigratedReason" Text="Unit code in this database is already logged as COMPLETED in tblUnitMigrationLog. Migration cannot proceed to prevent duplicate records." Foreground="#FECACA" FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                                    <Button Content="📜 View Migration Logs" Style="{StaticResource AppBtn}" Padding="10,5" MinHeight="28" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" HorizontalAlignment="Left" Click="BtnViewIntrmLogs_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#991B1B"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Helper Note pointing to Pre-Step -->
                            <TextBlock Text="💡 Don't see your database? Use the Restore / Attach Database card below ⬇"
                                       Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ================= PRE-STEP CARD: RESTORE / ATTACH DATABASE ================= -->
                    <Border Style="{StaticResource StageCard}" BorderBrush="#0D9488" BorderThickness="1.5">
                        <StackPanel>
                            <!-- Header: PRE-STEP badge + title -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#0F766E" CornerRadius="4" Padding="7,3" Margin="0,0,8,0">
                                    <TextBlock Text="PRE-STEP" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Restore / Attach Database" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15.5"/>
                            </StackPanel>

                            <!-- Target Server Banner (Shows WHICH server is connected) -->
                            <Border x:Name="borderPreStepServerStatus" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Target Server: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPreStepServerName" Text="🔒 Not Connected (Connect above)" Foreground="#F59E0B" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="Restore a .bak backup or attach a .mdf database file directly into the connected SQL Server before proceeding with migration."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Mode Selector -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="rdRestore" Content="Restore (.bak)" IsChecked="True"
                                             Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" Margin="0,0,16,0"
                                             Checked="RdMode_Checked"/>
                                <RadioButton x:Name="rdAttach" Content="Attach (.mdf)"
                                             Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13"
                                             Checked="RdMode_Checked"/>
                            </StackPanel>

                            <!-- ── RESTORE MODE PANEL ── -->
                            <StackPanel x:Name="panelRestoreMode">
                                <TextBlock Text="Backup File (.bak):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBakPath" Style="{StaticResource InputBox}" Height="30" FontSize="12.5" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="78" MinHeight="30" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" FontSize="12.5" Click="BtnBrowseBak_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target DB Name:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBox x:Name="txtRestoreDbName" Grid.Column="1" Style="{StaticResource InputBox}" Height="30" FontSize="13"/>
                                </Grid>
                            </StackPanel>

                            <!-- ── ATTACH MODE PANEL ── -->
                            <StackPanel x:Name="panelAttachMode" Visibility="Collapsed">
                                <TextBlock Text="Data File (.mdf):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtMdfPath" Style="{StaticResource InputBox}" Height="30" FontSize="12.5" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="78" MinHeight="30" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" FontSize="12.5" Click="BtnBrowseMdf_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Log File (.ldf) — Optional (rebuilds log if empty):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtLdfPath" Style="{StaticResource InputBox}" Height="30" FontSize="12.5" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="78" MinHeight="30" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" FontSize="12.5" Click="BtnBrowseLdf_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target DB Name:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBox x:Name="txtAttachDbName" Grid.Column="1" Style="{StaticResource InputBox}" Height="30" FontSize="13"/>
                                </Grid>
                            </StackPanel>

                            <!-- Progress bar (visible during operation) -->
                            <ProgressBar x:Name="pbPreStep" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Background="{DynamicResource ThemeCardBg}" Foreground="#0D9488"
                                         BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                         Margin="0,0,0,6" Visibility="Collapsed"/>

                            <!-- Status message -->
                            <TextBlock x:Name="txtPreStepStatus" Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Action Button -->
                            <Button x:Name="btnRunPreStep" MinHeight="42" Padding="16,8" IsEnabled="False"
                                    ToolTip="Please connect to a SQL Server in Stage 1 above first."
                                    Style="{StaticResource AppBtn}" Click="BtnRunPreStep_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="🚀 Restore / Attach Database" FontSize="13.5" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- ================= END PRE-STEP CARD ================= -->

                </StackPanel>
            </ScrollViewer>

            <!-- ================= RIGHT COLUMN (STEP PREVIEW & SEQUENTIAL PIPELINE PANELS) ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= WORKFLOW STEPPER PREVIEW BANNER (3 Steps) ================= -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- STEP 1 CHIP: Copy to Intermediate DB -->
                        <Border Grid.Column="0" x:Name="chipStep1" Background="{DynamicResource ThemeCardBg}" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="8" Padding="14,10"
                                Cursor="Hand" PreviewMouseLeftButtonUp="ChipStep1_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="borderChip1Badge" Width="30" Height="30" CornerRadius="15" Background="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtChip1Num" Text="1" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Step 1: Staging &amp; Prep" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14.5"/>
                                    <TextBlock x:Name="txtChip1Status" Text="Select DB &amp; stage data" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ARROW 1 -->
                        <TextBlock Grid.Column="1" Text="➔" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>

                        <!-- STEP 2 CHIP: Unicode Font Conversion -->
                        <Border Grid.Column="2" x:Name="chipStep2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1.5" CornerRadius="8" Padding="14,10"
                                Cursor="Hand" PreviewMouseLeftButtonUp="ChipStep2_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="borderChip2Badge" Width="30" Height="30" CornerRadius="15" Background="#64748B" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtChip2Num" Text="2" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Step 2: Font Conversion" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14.5"/>
                                    <TextBlock x:Name="txtChip2Status" Text="Convert to Unicode in intermediate DB" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ARROW 2 -->
                        <TextBlock Grid.Column="3" Text="➔" Foreground="#38BDF8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>

                        <!-- STEP 3 CHIP: Data Migration -->
                        <Border Grid.Column="4" x:Name="chipStep3" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1.5" CornerRadius="8" Padding="14,10"
                                Cursor="Hand" PreviewMouseLeftButtonUp="ChipStep3_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="borderChip3Badge" Width="30" Height="30" CornerRadius="15" Background="#64748B" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtChip3Num" Text="3" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Step 3: Core Migration" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14.5"/>
                                    <TextBlock x:Name="txtChip3Status" Text="Migrate to DLRSLSINF_4103PRSDB" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= RIGHT COLUMN (SEQUENTIAL PIPELINE PANELS) ================= -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <!-- STEP 1 PANEL: COPY SOURCE DATA TO INTERMEDIATE DB                         -->
                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <Border x:Name="panelStep1CopyToIntrm" Style="{StaticResource StageCard}" BorderBrush="#0284C7" BorderThickness="2">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Border Background="#0284C7" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="STEP 1 OF 3" Foreground="White" FontWeight="Bold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock Text="Data Staging &amp; Unified Migration Pipeline" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Proceed button on top if completed -->
                                <Button x:Name="btnGoToStep2" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource AppBtn}" Padding="14,7" MinHeight="34" Click="BtnGoToStep2_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#047857" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Proceed to Step 2: Font Conversion ➔" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ───────────────────────────────────────────────────────────────── -->
                            <!-- 1-CLICK AUTOMATED PIPELINE HERO CARD (DEFAULT RECOMMENDED MODE)   -->
                            <!-- ───────────────────────────────────────────────────────────────── -->
                            <Border x:Name="cardAutoPipelineHero" Background="{DynamicResource ThemeInsetBg}" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <!-- Header Badge and Title -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="#065F46" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ DEFAULT MODE • 1-CLICK AUTOMATION" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11.5"/>
                                            </Border>
                                            <TextBlock Text="Complete Automated Pipeline" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="Step 1 ➔ Step 2 ➔ Step 3" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Executes the full migration hands-free: copies tables into DLRS_Migration_Intrm, batch converts Bijoy/Adarshalipi text to Unicode, updates the intermediate DB, and executes core stored procedures sequentially in DLRSLSINF_4103PRSDB."
                                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- Visual 3-Phase Strip -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Phase 1 Pill -->
                                        <Border x:Name="borderAutoPhase1" Grid.Column="0" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtAutoPhase1Icon" Text="📥" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txtAutoPhase1Text" Text="1. Stage Data" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="➔" Foreground="#38BDF8" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="6,0"/>

                                        <!-- Phase 2 Pill -->
                                        <Border x:Name="borderAutoPhase2" Grid.Column="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtAutoPhase2Icon" Text="🔤" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txtAutoPhase2Text" Text="2. Font &amp; Update" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="➔" Foreground="#38BDF8" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="6,0"/>

                                        <!-- Phase 3 Pill -->
                                        <Border x:Name="borderAutoPhase3" Grid.Column="4" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock x:Name="txtAutoPhase3Icon" Text="🚀" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txtAutoPhase3Text" Text="3. Migration SPs" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Real-Time Progress Bar -->
                                    <ProgressBar x:Name="pbFullAutoPipeline" Height="14" Minimum="0" Maximum="100" Value="0"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#10B981" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                 Margin="0,0,0,10"/>

                                    <!-- Status Message and Timer -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtFullAutoStatus" Text="Ready — Connect server &amp; select a source database to begin" Foreground="#38BDF8" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="txtFullAutoDetail" Text="Built-in failsafes: non-destructive read-only source access, auto-detects commented-out SP branches." Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="txtFullAutoTimer" Text="⏱ 00:00" Foreground="#F59E0B" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Primary Auto Start Button -->
                                        <Button x:Name="btnStartFullAuto" MinHeight="50" Padding="20,12" IsEnabled="False"
                                                Style="{StaticResource AppBtn}" Click="BtnStartFullAuto_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2563EB" Offset="0"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🚀" Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="Start Complete Conversion &amp; Migration (Auto-Execute All)" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Active Controls (Pause/Stop) -->
                                        <StackPanel Grid.Column="1" x:Name="panelAutoControls" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                                            <Button x:Name="btnPauseFullAuto" Content="⏸ Pause" Width="76" MinHeight="48" Margin="0,0,6,0" Style="{StaticResource AppBtn}" Click="BtnPauseFullAuto_Click"/>
                                            <Button x:Name="btnStopFullAuto" Content="⏹ Stop" Width="76" MinHeight="48" Style="{StaticResource AppBtn}" Click="BtnStopFullAuto_Click">
                                                <Button.Background>
                                                    <SolidColorBrush Color="#DC2626"/>
                                                </Button.Background>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Completed Banner for Auto Execution -->
                                    <Border x:Name="borderAutoCompletedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🎉" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="ENTIRE CONVERSION &amp; MIGRATION PIPELINE COMPLETED!" Foreground="{DynamicResource ThemeSuccessText}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="txtAutoCompletedDetail" Text="All tables staged, converted to Unicode, and migrated into DLRSLSINF_4103PRSDB." Foreground="{DynamicResource ThemeSuccessText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="📜 View Logs" Style="{StaticResource AppBtn}" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnViewIntrmLogs_Click">
                                                <Button.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0D9488" Offset="0"/>
                                                        <GradientStop Color="#0F766E" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Button.Background>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ───────────────────────────────────────────────────────────────── -->
                            <!-- MANUAL SINGLE-STEP PANEL (Visible when Manual Control toggled)    -->
                            <!-- ───────────────────────────────────────────────────────────────── -->
                            <StackPanel x:Name="panelManualStep1">
                                <TextBlock Text="— OR EXECUTE STEP 1 MANUALLY (SINGLE STEP) —" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                                <TextBlock x:Name="txtStep1Desc" Text="Copies tblHalsabek, tblLinfo01, and tblLinfo02 from the selected source database into [DLRS_Migration_Intrm]. Automatically converts columns to Unicode NVARCHAR, sets initial tracking columns, and assigns sequential RowIds. The source database is NOT modified."
                                           Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <!-- Lock Banner for Step 1 (Shown when no DB selected) -->
                                <Border x:Name="borderStep1LockBanner" Background="{DynamicResource ThemeLockBg}" BorderBrush="{DynamicResource ThemeLockBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="STEP 1 WAITING — Select a Source Database" Foreground="{DynamicResource ThemeLockText}" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock Text="Connect to a SQL Server and select a source database from the left panel to enable data staging." Foreground="{DynamicResource ThemeLockText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Completed Banner for Step 1 -->
                                <Border x:Name="borderStep1CompletedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1.5" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✅" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="STEP 1 COMPLETED — DATA STAGED IN INTERMEDIATE DB" Foreground="{DynamicResource ThemeSuccessText}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock x:Name="txtStep1CompletedDetail" Text="All records copied to [DLRS_Migration_Intrm] with Unicode schema and tracking columns." Foreground="{DynamicResource ThemeSuccessText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="➔ Go to Step 2" Style="{StaticResource AppBtn}" Padding="14,8" Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnGoToStep2_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#059669" Offset="0"/>
                                                    <GradientStop Color="#047857" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Step 1 Progress Bar -->
                                <ProgressBar x:Name="pbStep1Copy" Height="10" Minimum="0" Maximum="100" IsIndeterminate="True"
                                             Background="{DynamicResource ThemeCardBg}" Foreground="#0284C7" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                             Margin="0,0,0,8" Visibility="Collapsed"/>

                                <!-- Step 1 Status Text -->
                                <TextBlock x:Name="txtStep1Status" Visibility="Collapsed" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Copy Button -->
                                <Button x:Name="btnCopyToIntrmDb" MinHeight="48" Padding="20,10" IsEnabled="False"
                                        Style="{StaticResource AppBtn}" Click="BtnCopyToIntrmDb_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                            <GradientStop Color="#0284C7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📥" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtBtnCopyToIntrm" Text="Copy Source Data to DLRS_Migration_Intrm (Single Step)" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <!-- STEP 2 PANEL: FONT CONVERSION (operates on DLRS_Migration_Intrm)          -->
                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <Border x:Name="panelStep2FontConvert" Visibility="Collapsed" Style="{StaticResource StageCard}" BorderBrush="#059669" BorderThickness="2">
                        <StackPanel>
                            <!-- Header with Back Button and Forward Button -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Border Background="#059669" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="STEP 2 OF 3" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Unicode Font Conversion &amp; Intermediate DB Update" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Navigation buttons on top -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="btnBackToStep1" Style="{StaticResource AppBtn}" Padding="12,6" MinHeight="32" Margin="0,0,6,0" Click="BtnBackToStep1_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                        <TextBlock Text="◀ Back to Step 1" FontSize="12.5" FontWeight="SemiBold"/>
                                    </Button>

                                    <Button x:Name="btnGoToStep3" Visibility="Collapsed" Style="{StaticResource AppBtn}" Padding="14,6" MinHeight="32" Click="BtnGoToStep3_Click">
                                        <Button.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                                <GradientStop Color="#7C3AED" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Button.Background>
                                        <TextBlock Text="Proceed to Step 3: Migration ➔" FontWeight="Bold" FontSize="12.5"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="txtStage3Desc" Text="Select staged tables from [DLRS_Migration_Intrm], fetch records, convert ANSI (Adarshalipi) text to Unicode with real-time ETA tracking, and write the converted data back to [DLRS_Migration_Intrm]."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Lock Banner for Step 2 (Shown when Step 1 not complete) -->
                            <Border x:Name="borderStage3LockBanner" Background="{DynamicResource ThemeLockBg}" BorderBrush="{DynamicResource ThemeLockBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="STEP 2 IS LOCKED — Complete Step 1 First" Foreground="{DynamicResource ThemeLockText}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Copy source data to [DLRS_Migration_Intrm] first before running font conversion." Foreground="{DynamicResource ThemeLockText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Unlocked Banner for Step 2 (Shown when Step 1 is complete) -->
                            <Border x:Name="borderStage3UnlockedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Step 1 completed! Data is staged in [DLRS_Migration_Intrm]. Ready for font conversion." Foreground="{DynamicResource ThemeSuccessText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Warning Banner when Data is Already Converted to Unicode -->
                            <Border x:Name="borderAlreadyConvertedWarning" Visibility="Collapsed"
                                     Background="{DynamicResource ThemeWarningBg}" BorderBrush="{DynamicResource ThemeWarningBorder}" BorderThickness="1"
                                     CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ALREADY CONVERTED DATA DETECTED" Foreground="{DynamicResource ThemeWarningText}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtAlreadyConvertedDetail" Foreground="{DynamicResource ThemeWarningText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="The following table(s) already contain Bengali Unicode text. Re-converting will corrupt characters!"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2A: TABLE SELECTION & FETCH -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="1. Table Selection &amp; Data Fetch (from DLRS_Migration_Intrm)" Foreground="#38BDF8" FontWeight="Bold" FontSize="14.5" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Tables ListBox -->
                                        <ListBox x:Name="lstTables" Height="90" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}" IsEnabled="False">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" Margin="2"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Fetch Button -->
                                        <Button x:Name="fetchDataForSelectedTables" Grid.Column="1" Width="210" MinHeight="40" Padding="16,8" Margin="12,0,0,0"
                                                Style="{StaticResource AppBtn}" IsEnabled="False" Click="ShowSelectedTables_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#059669" Offset="0"/>
                                                    <GradientStop Color="#047857" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="📥 Fetch Table Data" FontSize="13.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- Fetch Status Output -->
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="DataFetchingStatus" Visibility="Collapsed" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock x:Name="DataFetchingStatusFortblLinfo01" Visibility="Collapsed" Foreground="#4ADE80" FontSize="13"/>
                                        <TextBlock x:Name="tblLinfo01RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13"/>
                                        <TextBlock x:Name="DataFetchingStatus2" Visibility="Collapsed" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock x:Name="DataFetchingStatusFortblLinfo02" Visibility="Collapsed" Foreground="#4ADE80" FontSize="13"/>
                                        <TextBlock x:Name="tblLinfo02RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13"/>
                                        <TextBlock x:Name="fontConversionPermission" Visibility="Collapsed" Foreground="#34D399" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2B: FONT CONVERSION WITH LIVE PROGRESS BAR & REMAINING TIME -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="#059669" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="2. Font Conversion to Unicode" Foreground="#38BDF8" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center"/>
                                            <!-- Speed & Throttle Toggle Control -->
                                            <Border x:Name="panelAdminDelayControl" Margin="14,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                    CornerRadius="5" Padding="8,4">
                                                <CheckBox x:Name="chkConversionDelay" Content="Throttle Delay (2ms/row)" IsChecked="False"
                                                          Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center"
                                                          ToolTip="Default is 0ms (True Real-Time). Check this to intentionally throttle CPU usage by adding a 2ms delay per row. Configurable in AppConfig.cs."/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="fontConverterBTN" Grid.Column="1" Width="210" MinHeight="38" Padding="16,8" Style="{StaticResource AppBtn}"
                                                IsEnabled="False" Click="fontConverterBTN_On_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="🔤 Convert to Unicode" FontSize="13.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- REAL-TIME CONVERSION PROGRESS BAR -->
                                    <ProgressBar x:Name="pbConversion" Height="14" Minimum="0" Maximum="100" Value="0"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#10B981" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                 Margin="0,0,0,6"/>

                                    <!-- PROGRESS METRICS & REMAINING TIME (ETA) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Processed Counts & Speed -->
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock x:Name="lblConversionCount" Text="0 / 0 records" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13"/>
                                            <TextBlock x:Name="lblConversionSpeed" Text="" Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- Remaining Time & Percentage -->
                                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                                            <TextBlock x:Name="lblConversionEta" Text="⏱ Remaining: --:--" Foreground="#F59E0B" FontWeight="Bold" FontSize="13.5" Margin="0,0,14,0"/>
                                            <TextBlock x:Name="lblConversionPercent" Text="0.0%" Foreground="#10B981" FontWeight="Bold" FontSize="14.5"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status Lines -->
                                    <StackPanel>
                                        <TextBlock x:Name="FontConversionSts1" Visibility="Collapsed" Foreground="#38BDF8" FontSize="13"/>
                                        <TextBlock x:Name="tblLinfo01_Converted_RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo01_Converted_BatchCount" Visibility="Collapsed" Foreground="#4ADE80" FontSize="12"/>
                                        <TextBlock x:Name="FontConversionSts2" Visibility="Collapsed" Foreground="#38BDF8" FontSize="13"/>
                                        <TextBlock x:Name="tblLinfo02_Converted_RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo02_Converted_BatchCount" Visibility="Collapsed" Foreground="#4ADE80" FontSize="12"/>
                                        <TextBlock x:Name="FontConversionSts" Visibility="Collapsed" Foreground="#34D399" FontWeight="Bold" FontSize="14.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2C: INTERMEDIATE DATABASE UPDATE -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3. Update Intermediate Database with Unicode" Foreground="#38BDF8" FontWeight="Bold" FontSize="14.5" VerticalAlignment="Center"/>
                                        <Button x:Name="updateDatabaseBTN" Grid.Column="1" Width="225" MinHeight="40" Padding="16,8" Style="{StaticResource AppBtn}"
                                                IsEnabled="False" Click="updateDatabaseBTN_On_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="💾 Update Intermediate DB" FontSize="13.5" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- REAL-TIME DATABASE UPDATE PROGRESS BAR -->
                                    <ProgressBar x:Name="pbDbUpdate" Height="12" Minimum="0" Maximum="100" Value="0"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#8B5CF6" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                 Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblDbUpdateBatchInfo" Text="Batches pending" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13"/>
                                        <TextBlock x:Name="lblDbUpdatePercent" Grid.Column="1" Text="0%" Foreground="#A78BFA" FontWeight="Bold" FontSize="13.5"/>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock x:Name="tblLinfo01_Update_Status" Visibility="Collapsed" Foreground="#38BDF8" FontSize="13"/>
                                        <TextBlock x:Name="tblLinfo02_Update_Status" Visibility="Collapsed" Foreground="#38BDF8" FontSize="13"/>
                                        <TextBlock x:Name="dbUpdateSts" Visibility="Collapsed" Foreground="#34D399" FontWeight="Bold" FontSize="14.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <!-- STEP 3 PANEL: DATA MIGRATION TO CORE DB                                   -->
                    <!-- ═════════════════════════════════════════════════════════════════════════ -->
                    <Border x:Name="panelStep3Migration" Visibility="Collapsed" Style="{StaticResource StageCard}" BorderBrush="#7C3AED" BorderThickness="2">
                        <StackPanel>
                            <!-- Header with Back Button -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Border Background="#7C3AED" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="STEP 3 OF 3" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="Core Data Migration Pipeline" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button x:Name="btnBackToStep2" Grid.Column="1" Style="{StaticResource AppBtn}" Padding="12,6" MinHeight="32" Click="BtnBackToStep2_Click">
                                    <Button.Background>
                                        <SolidColorBrush Color="#475569"/>
                                    </Button.Background>
                                    <TextBlock Text="◀ Back to Step 2" FontSize="12.5" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="txtStage4Desc" Text="Executes the 7-step stored procedure (SP_LIS_DATA_MIGRATION) in [DLRSLSINF_4103PRSDB] to migrate Khatians, plots, owners, maps, and boundary data directly from [DLRS_Migration_Intrm] into the core production database."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Lock Banner for Step 3 -->
                            <Border x:Name="borderStage4LockBanner" Background="{DynamicResource ThemeLockBg}" BorderBrush="{DynamicResource ThemeLockBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Locked: Complete Step 2 (Font Conversion &amp; Intermediate DB Update) first." Foreground="{DynamicResource ThemeLockText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="borderStage4UnlockedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ready: Step 2 completed. You can now launch the Migration Wizard." Foreground="{DynamicResource ThemeSuccessText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Completed Banner for Step 3 -->
                            <Border x:Name="borderStage4CompletedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎉" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MIGRATION PIPELINE COMPLETED" Foreground="{DynamicResource ThemeSuccessText}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="All core migration steps have been executed and saved into [DLRSLSINF_4103PRSDB]." Foreground="{DynamicResource ThemeSuccessText}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnDataMigrationWizard" MinHeight="48" Padding="20,12" Style="{StaticResource AppBtn}" IsEnabled="False" Click="BtnDataMigrationWizard_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#D946EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock x:Name="txtBtnDataMigrationWizard" Text="🚀 Launch Data Migration Wizard" FontSize="15" FontWeight="Bold"/>
                            </Button>

                            <!-- View Migrated Unit Codes Button (Shown when Step 3 is completed) -->
                            <Button x:Name="btnViewMigratedUnits" Visibility="Collapsed" MinHeight="42" Padding="16,8" Margin="0,10,0,0"
                                    Style="{StaticResource AppBtn}" Click="BtnViewMigratedUnits_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,8,0" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="View Migrated Unit Codes Report" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
