<Window x:Class="LandPressDataMigrationDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="DLRS Data Migration Tool" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <!-- Stage Card Style -->
        <Style x:Key="StageCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Input Box Style -->
        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Rounded Gradient Button -->
        <Style x:Key="AppBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#64748B"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ================= FOOTER ================= -->
        <Border DockPanel.Dock="Bottom" Padding="18,8" Background="{DynamicResource ThemeFooterBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                           Text="DLRS Data Migration Tool  v0.6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Text="Powered by "/>
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#F97316" Text="Pirthe Limited"/>
                </StackPanel>

                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}"
                           Text="© 2026 Pirthe Limited. All rights reserved."/>
            </Grid>
        </Border>

        <!-- ================= TOP APP BAR (BRANDING, USER ROLE, THEME TOGGLE) ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Title and Role Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Image Source="/Assets/DLRS-Migration App Icon.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="DLRS Data Migration Tool" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#1D4ED8" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="borderUserRoleBadge" Background="#065F46" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtUserRoleBadge" Text="👤 Admin (Full Access)" Foreground="#6EE7B7" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Right: Theme Toggle Button -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="btnThemeToggle" Style="{StaticResource AppBtn}" Padding="12,6"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                            BorderThickness="1" Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= TOP WORKFLOW STEPPER BANNER ================= -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- STEP 1 CHIP -->
                <Border Grid.Column="0" x:Name="chipStep1" Background="{DynamicResource ThemeCardBg}" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="borderChip1Badge" Width="22" Height="22" CornerRadius="11" Background="#3B82F6" Margin="0,0,8,0">
                            <TextBlock x:Name="txtChip1Num" Text="1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Step 1: Database Selection" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="txtChip1Status" Text="Connect &amp; select source DB" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ARROW 1 -->
                <TextBlock Grid.Column="1" Text="➔" Foreground="{DynamicResource ThemeTextMuted}" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>

                <!-- STEP 2 CHIP -->
                <Border Grid.Column="2" x:Name="chipStep2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="borderChip2Badge" Width="22" Height="22" CornerRadius="11" Background="#64748B" Margin="0,0,8,0">
                            <TextBlock x:Name="txtChip2Num" Text="2" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Step 2: Compatibility &amp; Prep" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="txtChip2Status" Text="Prerequisite for Conversion" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ARROW 2 -->
                <TextBlock Grid.Column="3" Text="➔" Foreground="{DynamicResource ThemeTextMuted}" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>

                <!-- STEP 3 CHIP -->
                <Border Grid.Column="4" x:Name="chipStep3" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="borderChip3Badge" Width="22" Height="22" CornerRadius="11" Background="#64748B" Margin="0,0,8,0">
                            <TextBlock x:Name="txtChip3Num" Text="3" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Step 3: Font Conversion" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="txtChip3Status" Text="Locked (Needs Step 2)" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ARROW 3 -->
                <TextBlock Grid.Column="5" Text="➔" Foreground="{DynamicResource ThemeTextMuted}" FontSize="14" VerticalAlignment="Center" Margin="8,0"/>

                <!-- STEP 4 CHIP -->
                <Border Grid.Column="6" x:Name="chipStep4" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="borderChip4Badge" Width="22" Height="22" CornerRadius="11" Background="#64748B" Margin="0,0,8,0">
                            <TextBlock x:Name="txtChip4Num" Text="4" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Step 4: Data Migration" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="txtChip4Status" Text="Locked (Needs Step 3)" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKFLOW CONTENT (2-COLUMN SEQUENTIAL PIPELINE) ================= -->
        <Grid Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <!-- Left: Stage 1, Stage 2, Stage 4 -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Stage 3 (Font Conversion & DB Update) -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN ================= -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
                <StackPanel>

                    <!-- ================= PRE-STEP CARD: RESTORE / ATTACH DATABASE ================= -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <!-- Header: PRE-STEP badge + title -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#0F766E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="PRE-STEP" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Restore / Attach Database" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>

                            <!-- Description -->
                            <TextBlock Text="Restore a .bak backup or attach a .mdf database file directly into SQL Server before proceeding with the migration stages."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- Mode Selector -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="rdRestore" Content="Restore (.bak)" IsChecked="True"
                                             Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,16,0"
                                             Checked="RdMode_Checked"/>
                                <RadioButton x:Name="rdAttach" Content="Attach (.mdf)"
                                             Foreground="{DynamicResource ThemeTextPrimary}"
                                             Checked="RdMode_Checked"/>
                            </StackPanel>

                            <!-- ── RESTORE MODE PANEL ── -->
                            <StackPanel x:Name="panelRestoreMode">
                                <TextBlock Text="Backup File (.bak):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                <!-- .bak file picker -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBakPath" Style="{StaticResource InputBox}" Height="28" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="74" MinHeight="28" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" Click="BtnBrowseBak_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <!-- DB name input -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target DB Name:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBox x:Name="txtRestoreDbName" Grid.Column="1" Style="{StaticResource InputBox}" Height="28"/>
                                </Grid>
                            </StackPanel>

                            <!-- ── ATTACH MODE PANEL ── -->
                            <StackPanel x:Name="panelAttachMode" Visibility="Collapsed">
                                <TextBlock Text="Data File (.mdf):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                <!-- .mdf file picker -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtMdfPath" Style="{StaticResource InputBox}" Height="28" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="74" MinHeight="28" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" Click="BtnBrowseMdf_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Log File (.ldf) — Optional (rebuilds log if empty):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                <!-- .ldf file picker (optional) -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtLdfPath" Style="{StaticResource InputBox}" Height="28" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="Browse…" Width="74" MinHeight="28" Padding="10,4" Margin="6,0,0,0"
                                            Style="{StaticResource AppBtn}" Click="BtnBrowseLdf_Click">
                                        <Button.Background>
                                            <SolidColorBrush Color="#475569"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>
                                <!-- DB name input -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Target DB Name:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                                    <TextBox x:Name="txtAttachDbName" Grid.Column="1" Style="{StaticResource InputBox}" Height="28"/>
                                </Grid>
                            </StackPanel>

                            <!-- Progress bar (visible during operation) -->
                            <ProgressBar x:Name="pbPreStep" Height="8" Minimum="0" Maximum="100" Value="0"
                                         Background="{DynamicResource ThemeCardBg}" Foreground="#0D9488"
                                         BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                         Margin="0,0,0,6" Visibility="Collapsed"/>

                            <!-- Status message -->
                            <TextBlock x:Name="txtPreStepStatus" Visibility="Collapsed"
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Action Button -->
                            <Button x:Name="btnRunPreStep" MinHeight="38" Padding="16,8"
                                    Style="{StaticResource AppBtn}" Click="BtnRunPreStep_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="🚀 Restore / Attach Database" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- ================= END PRE-STEP CARD ================= -->

                    <!-- STAGE 1 CARD: CONNECT & SELECT DATABASE -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="#1D4ED8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="STAGE 1" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Database Connection &amp; Selection" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>

                            <!-- Server & Auth Bar -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                                <TextBox x:Name="txtServer" Grid.Column="1" Style="{StaticResource InputBox}" Height="28"/>
                                <TextBlock Grid.Column="2" Text="Auth:" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="12"/>
                                <ComboBox x:Name="cmbAuth" Grid.Column="3" Width="90" Height="28" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}">
                                    <ComboBoxItem Content="Windows"/>
                                    <ComboBoxItem Content="SQL"/>
                                </ComboBox>
                            </Grid>

                            <!-- SQL User/Password (if SQL Auth selected) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="txtUser" Width="140" Margin="0,0,6,0" Style="{StaticResource InputBox}" Height="28" Visibility="Collapsed"/>
                                <PasswordBox x:Name="txtPassword" Width="140" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}" Height="28" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Connect Button & Status -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Connect" Width="100" Height="32" Padding="14,6" Style="{StaticResource AppBtn}" Click="Connect_Click">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#2563EB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                <TextBlock x:Name="txtConnectError" Visibility="Collapsed" VerticalAlignment="Center"
                                           Margin="10,0,0,0" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Databases List -->
                            <TextBlock Text="Available Databases (click to select):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                            <ListBox x:Name="lstDatabases" Height="140" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}"
                                     SelectionChanged="Databases_SelectionChanged"/>

                            <!-- Active Database Banner -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active Database: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtActiveDbName" Text="(None Selected)" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- STAGE 2 CARD: DATABASE PREPARATION & COMPATIBILITY -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="STAGE 2" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Database Preparation &amp; Compatibility" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="txtStage2Desc" Text="Sets database compatibility level (130+), alters columns to NVARCHAR, adds RowId and convsts tracking columns."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Status Badge & Helper -->
                            <Border x:Name="borderStage2Status" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="badgeStage2" Background="#475569" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                            <TextBlock x:Name="txtStage2Badge" Text="PENDING" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="txtStage2StatusTitle" Text="Select a database to verify" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtStage2StatusDetail" Text="Prerequisites must be completed before Stage 3 (Font Conversion) will unlock." Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnPrepareDb" MinHeight="40" Padding="18,8" Style="{StaticResource AppBtn}" Click="BtnPrepareDb_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0EA5E9" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock Text="🛠 Open Database Preparation Wizard" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- STAGE 4 CARD: DATA MIGRATION TO CORE DB -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#7C3AED" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="STAGE 4" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Data Migration Pipeline" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock x:Name="txtStage4Desc" Text="Executes the 7-step stored procedure (SP_LIS_DATA_MIGRATION) in [DLRSLSINF_4103PRSDB] to migrate Khatians, plots, owners, maps, and handle mismatches."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <!-- Lock / Unlock Banner for Stage 4 -->
                            <Border x:Name="borderStage4LockBanner" Background="{DynamicResource ThemeLockBg}" BorderBrush="{DynamicResource ThemeLockBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Locked: Complete Stage 3 (Font Conversion &amp; DB Update) first." Foreground="{DynamicResource ThemeLockText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="borderStage4UnlockedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ready: Stage 3 completed. You can now launch the Migration Wizard." Foreground="{DynamicResource ThemeSuccessText}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Completed Banner for Stage 4 -->
                            <Border x:Name="borderStage4CompletedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎉" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MIGRATION PIPELINE COMPLETED" Foreground="{DynamicResource ThemeSuccessText}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="All core migration steps have been executed and saved into [DLRSLSINF_4103PRSDB]." Foreground="{DynamicResource ThemeSuccessText}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnDataMigrationWizard" MinHeight="42" Padding="18,8" Style="{StaticResource AppBtn}" IsEnabled="False" Click="BtnDataMigrationWizard_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B5CF6" Offset="0"/>
                                        <GradientStop Color="#D946EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <TextBlock x:Name="txtBtnDataMigrationWizard" Text="🚀 Launch Data Migration Wizard" FontSize="13" FontWeight="SemiBold"/>
                            </Button>

                            <!-- View Migrated Unit Codes Button (Shown when Stage 4 is completed) -->
                            <Button x:Name="btnViewMigratedUnits" Visibility="Collapsed" MinHeight="36" Padding="14,6" Margin="0,8,0,0"
                                    Style="{StaticResource AppBtn}" Click="BtnViewMigratedUnits_Click">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0D9488" Offset="0"/>
                                        <GradientStop Color="#0F766E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,8,0" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="View Migrated Unit Codes Report" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ================= RIGHT COLUMN (STAGE 3: FONT CONVERSION & DATABASE UPDATE) ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- STAGE 3 CARD HEADER -->
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#059669" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="STAGE 3" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <TextBlock Text="Unicode Font Conversion &amp; Database Update" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15"/>
                            </StackPanel>
                            <TextBlock x:Name="txtStage3Desc" Text="Select target tables, fetch records from source database, convert ANSI (Adarshalipi) font to Unicode with real-time ETA tracking, and update back to the database."
                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <!-- Lock Banner for Stage 3 (Shown when Stage 2 is incomplete) -->
                            <Border x:Name="borderStage3LockBanner" Background="{DynamicResource ThemeLockBg}" BorderBrush="{DynamicResource ThemeLockBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔒" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="STAGE 3 IS LOCKED — Complete Stage 2 First" Foreground="{DynamicResource ThemeLockText}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock Text="Database Preparation &amp; Compatibility (Level 130+, NVARCHAR, RowId, convsts) must be completed before tables can be fetched or converted." Foreground="{DynamicResource ThemeLockText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Unlocked Banner for Stage 3 (Shown when Stage 2 is complete) -->
                            <Border x:Name="borderStage3UnlockedBanner" Visibility="Collapsed" Background="{DynamicResource ThemeSuccessBg}" BorderBrush="{DynamicResource ThemeSuccessBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Stage 2 prerequisites verified! Stage 3 is unlocked and ready for font conversion." Foreground="{DynamicResource ThemeSuccessText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Warning Banner when Database / Tables are Already Converted to Unicode -->
                            <Border x:Name="borderAlreadyConvertedWarning" Visibility="Collapsed"
                                    Background="{DynamicResource ThemeWarningBg}" BorderBrush="{DynamicResource ThemeWarningBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ALREADY CONVERTED DATA DETECTED" Foreground="{DynamicResource ThemeWarningText}" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtAlreadyConvertedDetail" Foreground="{DynamicResource ThemeWarningText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Text="The following table(s) already contain Bengali Unicode text. Re-converting will corrupt characters!"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3A: TABLE SELECTION & FETCH -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="1. Table Selection &amp; Data Fetch" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Tables ListBox -->
                                        <ListBox x:Name="lstTables" Height="90" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}" IsEnabled="False">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="2"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Fetch Button -->
                                        <Button x:Name="fetchDataForSelectedTables" Grid.Column="1" Width="210" MinHeight="40" Padding="16,8" Margin="12,0,0,0"
                                                Style="{StaticResource AppBtn}" IsEnabled="False" Click="ShowSelectedTables_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#059669" Offset="0"/>
                                                    <GradientStop Color="#047857" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="📥 Fetch Table Data" FontSize="13" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- Fetch Status Output -->
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="DataFetchingStatus" Visibility="Collapsed" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock x:Name="DataFetchingStatusFortblLinfo01" Visibility="Collapsed" Foreground="#4ADE80" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo01RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="DataFetchingStatus2" Visibility="Collapsed" Foreground="#38BDF8" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock x:Name="DataFetchingStatusFortblLinfo02" Visibility="Collapsed" Foreground="#4ADE80" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo02RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="fontConversionPermission" Visibility="Collapsed" Foreground="#34D399" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3B: FONT CONVERSION WITH LIVE PROGRESS BAR & REMAINING TIME -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="2. Font Conversion to Unicode" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                            <!-- Admin Delay Toggle Control -->
                                            <Border x:Name="panelAdminDelayControl" Margin="14,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                    CornerRadius="5" Padding="8,4">
                                                <CheckBox x:Name="chkConversionDelay" Content="Throttle Delay (2ms/row)" IsChecked="False"
                                                          Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"
                                                          ToolTip="When enabled, adds a 2ms delay per row to throttle system CPU during conversion."/>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="fontConverterBTN" Grid.Column="1" Width="195" MinHeight="36" Padding="16,8" Style="{StaticResource AppBtn}"
                                                IsEnabled="False" Click="fontConverterBTN_On_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#10B981" Offset="0"/>
                                                    <GradientStop Color="#059669" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="🔤 Convert to Unicode" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- REAL-TIME CONVERSION PROGRESS BAR -->
                                    <ProgressBar x:Name="pbConversion" Height="14" Minimum="0" Maximum="100" Value="0"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#10B981" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                 Margin="0,0,0,6"/>

                                    <!-- PROGRESS METRICS & REMAINING TIME (ETA) -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Processed Counts & Speed -->
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock x:Name="lblConversionCount" Text="0 / 0 records" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                            <TextBlock x:Name="lblConversionSpeed" Text="" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" Margin="10,0,0,0"/>
                                        </StackPanel>

                                        <!-- Remaining Time & Percentage -->
                                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                                            <TextBlock x:Name="lblConversionEta" Text="⏱ Remaining: --:--" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/>
                                            <TextBlock x:Name="lblConversionPercent" Text="0.0%" Foreground="#10B981" FontWeight="Bold" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Status Lines -->
                                    <StackPanel>
                                        <TextBlock x:Name="FontConversionSts1" Visibility="Collapsed" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo01_Converted_RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                        <TextBlock x:Name="tblLinfo01_Converted_BatchCount" Visibility="Collapsed" Foreground="#4ADE80" FontSize="11"/>
                                        <TextBlock x:Name="FontConversionSts2" Visibility="Collapsed" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo02_Converted_RowCount" Visibility="Collapsed" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                        <TextBlock x:Name="tblLinfo02_Converted_BatchCount" Visibility="Collapsed" Foreground="#4ADE80" FontSize="11"/>
                                        <TextBlock x:Name="FontConversionSts" Visibility="Collapsed" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3C: DATABASE UPDATE -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3. Update Source Database with Unicode" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                        <Button x:Name="updateDatabaseBTN" Grid.Column="1" Width="215" MinHeight="36" Padding="16,8" Style="{StaticResource AppBtn}"
                                                IsEnabled="False" Click="updateDatabaseBTN_On_Click">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="💾 Update Database" FontSize="12" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <!-- REAL-TIME DATABASE UPDATE PROGRESS BAR -->
                                    <ProgressBar x:Name="pbDbUpdate" Height="10" Minimum="0" Maximum="100" Value="0"
                                                 Background="{DynamicResource ThemeCardBg}" Foreground="#8B5CF6" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                 Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="lblDbUpdateBatchInfo" Text="Batches pending" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12"/>
                                        <TextBlock x:Name="lblDbUpdatePercent" Grid.Column="1" Text="0%" Foreground="#A78BFA" FontWeight="Bold" FontSize="12"/>
                                    </Grid>

                                    <StackPanel>
                                        <TextBlock x:Name="tblLinfo01_Update_Status" Visibility="Collapsed" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock x:Name="tblLinfo02_Update_Status" Visibility="Collapsed" Foreground="#38BDF8" FontSize="12"/>
                                        <TextBlock x:Name="dbUpdateSts" Visibility="Collapsed" Foreground="#34D399" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
