<Window x:Class="LandPressDataMigrationDesktopApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="DLRS Data Migration Tool - Login"
        Height="560" Width="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}">

    <Window.Resources>
        <Style x:Key="InputTextBox" TargetType="Control">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="LoginBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemePillBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pbd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pbd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- FOOTER -->
        <Border DockPanel.Dock="Bottom" Padding="16,12" Background="{DynamicResource ThemeFooterBg}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Powered by " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Pirthe Limited" Foreground="#F97316" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- TOP BAR: THEME SWITCHER -->
        <Border DockPanel.Dock="Top" Padding="18,10" Background="Transparent">
            <DockPanel LastChildFill="False">
                <Button x:Name="btnThemeToggle" DockPanel.Dock="Right" Style="{StaticResource ThemePillBtn}"
                        Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                        Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtThemeLabel" Text="Light" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- MAIN LOGIN CARD -->
        <Grid Margin="32,0,32,16">
            <StackPanel VerticalAlignment="Center">

                <!-- LOGO / HEADER -->
                <Border Width="68" Height="68" CornerRadius="16" Margin="0,0,0,14" HorizontalAlignment="Center"
                        Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
                    <Image Source="/Assets/DLRS-Migration App Icon.png" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="DLRS Data Migration"
                           Foreground="{DynamicResource ThemeTextPrimary}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Authorized Access Portal"
                           Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="12"
                           Margin="0,4,0,20"
                           HorizontalAlignment="Center"/>

                <!-- USERNAME -->
                <TextBlock Text="Username"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="txtUsername"
                         Style="{StaticResource InputTextBox}"
                         Height="38"
                         KeyDown="Input_KeyDown"/>

                <!-- PASSWORD -->
                <TextBlock Text="Password"
                           Foreground="{DynamicResource ThemeTextSecondary}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,12,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             Background="{DynamicResource ThemeCardBg}"
                             Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeCardBorder}"
                             BorderThickness="1"
                             FontSize="13"
                             Padding="10,8"
                             Height="38"
                             KeyDown="Input_KeyDown"/>

                <!-- ERROR MESSAGE -->
                <TextBlock x:Name="txtError"
                           Foreground="#EF4444"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- LOGIN BUTTON -->
                <Button x:Name="btnLogin"
                        Content="Sign In"
                        Style="{StaticResource LoginBtn}"
                        Height="42"
                        Margin="0,16,0,0"
                        Click="BtnLogin_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B82F6" Offset="0"/>
                            <GradientStop Color="#6366F1" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <!-- ACCOUNT INFO HINT -->
                <TextBlock Text="Admin: Full System Access  •  User: Standard Operation Mode"
                           Foreground="{DynamicResource ThemeTextMuted}"
                           FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
