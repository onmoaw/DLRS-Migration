<Window x:Class="LandPressDataMigrationDesktopApp.PipelineLogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        Title="Pipeline Execution &amp; Mapping Log Viewer"
        Height="640" Width="980"
        MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Segoe UI, Segoe UI Variable, Kalpurush, Vrinda, Arial"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="LogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Metrics -->
            <RowDefinition Height="Auto"/> <!-- Filters -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ROW 0: HEADER & METRICS SUMMARY PILLS                      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Pipeline Execution &amp; Value Mapping Logs" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Inspects pipeline status, breaking exceptions, and character/value mapping issues in real-time."
                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" Margin="26,2,0,0"/>
                </StackPanel>

                <!-- Right: Summary Counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Count -->
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock x:Name="txtCountTotal" Text="Total: 0" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                    <!-- Errors Count -->
                    <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock x:Name="txtCountErrors" Text="❌ Errors: 0" Foreground="#FCA5A5" FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                    <!-- Warnings Count -->
                    <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock x:Name="txtCountWarnings" Text="⚠️ Warnings: 0" Foreground="#FCD34D" FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                    <!-- Info Count -->
                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="10,5">
                        <TextBlock x:Name="txtCountInfo" Text="ℹ Info: 0" Foreground="#7DD3FC" FontWeight="Bold" FontSize="11.5"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ROW 1: SEARCH & FILTER BAR                                 -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBlock Text="🔍 Filter:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtSearchFilter" Grid.Column="1" Height="28" Padding="6,2" VerticalContentAlignment="Center"
                         Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}"
                         TextChanged="TxtSearchFilter_TextChanged" ToolTip="Filter by message, table, column, record id, or values..."/>

                <!-- Severity Dropdown -->
                <TextBlock Grid.Column="2" Text="Severity:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="cmbSeverityFilter" Grid.Column="3" Height="28" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}"
                          SelectionChanged="CmbSeverityFilter_SelectionChanged">
                    <ComboBoxItem Content="All Severities" IsSelected="True"/>
                    <ComboBoxItem Content="❌ Errors Only"/>
                    <ComboBoxItem Content="⚠️ Warnings &amp; Errors"/>
                    <ComboBoxItem Content="ℹ Info Only"/>
                </ComboBox>

                <!-- Phase Dropdown -->
                <TextBlock Grid.Column="4" Text="Phase:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox x:Name="cmbPhaseFilter" Grid.Column="5" Height="28" Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeInputBorder}"
                          SelectionChanged="CmbPhaseFilter_SelectionChanged">
                    <ComboBoxItem Content="All Phases" IsSelected="True"/>
                    <ComboBoxItem Content="Pre-Check"/>
                    <ComboBoxItem Content="Step 1 (Staging)"/>
                    <ComboBoxItem Content="Step 2 (Font Conversion)"/>
                    <ComboBoxItem Content="Step 2 (DB Update)"/>
                    <ComboBoxItem Content="Step 3 (Migration SP)"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ROW 2: STRUCTURED LOGS DATAGRID                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="gridLogs" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}"
                      RowBackground="{DynamicResource ThemeCardBg}" AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Time -->
                    <DataGridTextColumn Header="Time" Binding="{Binding TimeFormatted}" Width="75"/>

                    <!-- Severity Icon & Text -->
                    <DataGridTemplateColumn Header="Severity" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SeverityIcon}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Phase -->
                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="140"/>

                    <!-- Table -->
                    <DataGridTextColumn Header="Table" Binding="{Binding Table}" Width="110"/>

                    <!-- Column -->
                    <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="90"/>

                    <!-- Record Identifier -->
                    <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" Width="100"/>

                    <!-- Message / Issue -->
                    <DataGridTextColumn Header="Issue / Message" Binding="{Binding Message}" Width="*"/>

                    <!-- Raw Value -->
                    <DataGridTextColumn Header="Raw Value" Binding="{Binding RawValue}" Width="130"/>

                    <!-- Converted Unicode -->
                    <DataGridTextColumn Header="Converted Unicode" Binding="{Binding ConvertedValue}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- ROW 3: FOOTER ACTIONS                                      -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Export to CSV -->
            <Button Grid.Column="0" Content="📥 Export Logs to CSV" Style="{StaticResource LogBtn}" Padding="14,6" Margin="0,0,8,0" Click="BtnExportCsv_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0284C7" Offset="0"/>
                        <GradientStop Color="#0369A1" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Clear Logs -->
            <Button Grid.Column="1" Content="🗑 Clear Logs" Style="{StaticResource LogBtn}" Padding="12,6" Click="BtnClearLogs_Click">
                <Button.Background>
                    <SolidColorBrush Color="#475569"/>
                </Button.Background>
            </Button>

            <!-- Close Button -->
            <Button Grid.Column="3" Content="Close" Width="100" Style="{StaticResource LogBtn}" Padding="14,6" Click="BtnClose_Click">
                <Button.Background>
                    <SolidColorBrush Color="#334155"/>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>
</Window>
