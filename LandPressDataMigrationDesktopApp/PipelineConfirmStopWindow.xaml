<Window x:Class="LandPressDataMigrationDesktopApp.PipelineConfirmStopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Stop Operation"
        Height="440" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Segoe UI, Kalpurush, Vrinda, Arial"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="bdIcon" Width="50" Height="50" CornerRadius="25" Background="#7F1D1D" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="⏹" Foreground="#FCA5A5" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtDialogTitle" Text="Confirm Stop Operation" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="txtPhaseBadge" Text="Current Phase: Font Conversion" Foreground="#F59E0B" FontSize="13.5" FontWeight="SemiBold" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Message Body -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="txtWarningNotice" Text="Are you sure you want to stop the current operation?"
                               Foreground="{DynamicResource ThemeTextPrimary}" FontSize="14.5" FontWeight="SemiBold" LineHeight="22" Margin="0,0,0,8"/>

                    <TextBlock x:Name="txtPhaseConsequence" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,12"
                               Text="Stopping will cancel the remaining work in this step."/>

                    <!-- Technical Details (Admin Only) -->
                    <StackPanel x:Name="panelTechDetails" Visibility="Collapsed">
                        <TextBlock Text="Technical Diagnostics (Admin):" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTechDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas, Segoe UI" FontSize="11.5" Height="80"
                                 Background="{DynamicResource ThemeInputBg}" Foreground="{DynamicResource ThemeTextPrimary}"
                                 BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="8"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Yes, Stop button -->
            <Button Grid.Column="1" x:Name="btnConfirmStop" Content="Yes, Stop Operation" Style="{StaticResource DialogBtn}" Margin="0,0,10,0" Click="BtnConfirmStop_Click">
                <Button.Background>
                    <SolidColorBrush Color="#DC2626"/>
                </Button.Background>
            </Button>

            <!-- Continue Running button (default & focused) -->
            <Button Grid.Column="2" x:Name="btnContinue" Content="Continue Running" IsDefault="True" Style="{StaticResource DialogBtn}" Click="BtnContinue_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>
</Window>
