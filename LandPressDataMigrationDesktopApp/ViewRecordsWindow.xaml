                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomFitWidth_Click" ToolTip="উইন্ডোর মাপ অনুযায়ী পর্চার সম্পূর্ণ প্রস্থ দেখতে ক্লিক করুন"/>
                                        <Button x:Name="btnZoomReset" Content="🔄 ১০০%" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="4,0,0,0"
                                                Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomReset_Click" ToolTip="প্রকৃত আকারে রিসেট"/>
                                    </StackPanel>
                                </Border>

                                <!-- Fullscreen Button -->
                                <Button x:Name="btnKhatianFullscreen" Content="⛶ ফুলস্ক্রিন" Style="{StaticResource ActionBtn}"
                                        Background="#0284C7" Foreground="White" Padding="12,6" FontSize="13" Margin="0,0,8,0"
                                        Click="BtnEnterFullscreen_Click" ToolTip="পূর্ণ পর্দায় খতিয়ান দেখুন"/>

                                <!-- Admin Print Button -->
                                <Button x:Name="btnKhatianPrint" Content="🖨️ প্রিন্ট করুন" Style="{StaticResource ActionBtn}"
