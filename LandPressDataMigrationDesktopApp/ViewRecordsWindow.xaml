                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomOut_Click" ToolTip="জুম আউট (Ctrl + মাউস স্ক্রোল ডাউন)"/>
                                        <Slider x:Name="slKhatianZoom" Minimum="0.5" Maximum="2.5" Value="1.0" SmallChange="0.05" LargeChange="0.1" Width="100" VerticalAlignment="Center"
