                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="📋 খতিয়ান পরিচিতি ও সারাংশ" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <Border Background="#065F46" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtPrevBadgeStatus" Text="খসড়া" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Grid Row 1 with Hero Highlighted Current Khatian Card -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Highlighted Hero Card for Selected Current Khatian -->
                                        <Border Grid.Column="0" Background="#0284C7" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="বর্তমান খতিয়ান নং" Foreground="#E0F2FE" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="txtPrevCurrentKhatian" Text="—" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="সাবেক খতিয়ান নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevFormerKhatian" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="এন্ট্রি খতিয়ান নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevEntryKhatian" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="নকশা শিট নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevSheet" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid Row 2 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="মৌজার নাম:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevMouza" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="জরিপের ধরন:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevSurvey" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="মোট দাগ সংখ্যা:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevTotalPlots" Text="—" Style="{StaticResource PropVal}" Foreground="#059669"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="মোট জমির পরিমাণ (একর):" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevTotalArea" Text="—" Style="{StaticResource PropVal}" Foreground="#059669"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid Row 3 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="খতিয়ানের ধরন:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevLandType" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="পর্চা শিরোনাম:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevPorchaTitle" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="মন্তব্য ও বিবরণ:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevKhatianRemarks" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 2: OWNERS TABLE ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👥 মালিকগণের বিবরণ (Owners)" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <TextBlock Grid.Column="1" x:Name="txtOwnerCount" Text="মালিক সংখ্যা: ০ জন" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <DataGrid x:Name="dgOwners" Style="{StaticResource ModernDataGrid}" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <!-- Serial Number in Bangla -->
                                            <DataGridTextColumn Header="#" Binding="{Binding SlNo, Converter={StaticResource BanglaNumConverter}}" Width="50"/>
                                            <DataGridTextColumn Header="মালিকের নাম" Binding="{Binding OwnerName}" Width="190" FontWeight="Bold">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="পিতা / স্বামীর নাম" Binding="{Binding FatherName}" Width="170">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="মাতার নাম" Binding="{Binding MotherName}" Width="150">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="স্বামী / স্ত্রী" Binding="{Binding SpouseName}" Width="130">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="লিঙ্গ" Binding="{Binding Gender}" Width="75"/>
                                            <DataGridTextColumn Header="এনআইডি নম্বর" Binding="{Binding Nid, Converter={StaticResource BanglaNumConverter}}" Width="140"/>
                                            <DataGridTextColumn Header="জন্ম নিবন্ধন নং" Binding="{Binding BirthReg, Converter={StaticResource BanglaNumConverter}}" Width="130"/>
                                            <DataGridTextColumn Header="মোবাইল" Binding="{Binding Phone, Converter={StaticResource BanglaNumConverter}}" Width="115"/>
                                            <DataGridTextColumn Header="ঠিকানা" Binding="{Binding Address}" Width="220">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="LineHeight" Value="17"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="অংশ / জমির পরিমাণ" Binding="{Binding OwnerShareArea, Converter={StaticResource BanglaNumConverter}, ConverterParameter='0.0000'}" Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 3: PLOTS & LAND CLASSIFICATION ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🗺️ দাগ ও জমির শ্রেণী (Plots &amp; Land Classification)" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <TextBlock Grid.Column="1" x:Name="txtPlotCount" Text="দাগ সংখ্যা: ০টি" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <DataGrid x:Name="dgPlots" Style="{StaticResource ModernDataGrid}" MaxHeight="320"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              Loaded="DgPlots_Loaded" SizeChanged="DgPlots_SizeChanged">
                                        <DataGrid.Columns>
                                            <!-- Serial Number in Bangla -->
                                            <DataGridTextColumn Header="#" Binding="{Binding SlNo, Converter={StaticResource BanglaNumConverter}}" Width="50"/>
                                            <DataGridTextColumn Header="বর্তমান দাগ নং" Binding="{Binding CurrentPlot, Converter={StaticResource BanglaNumConverter}}" Width="120" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="সাবেক দাগ নং" Binding="{Binding FormerPlot, Converter={StaticResource BanglaNumConverter}}" Width="105"/>
                                            <DataGridTextColumn Header="সি.এস. দাগ নং" Binding="{Binding CsPlot, Converter={StaticResource BanglaNumConverter}}" Width="100"/>
                                            <DataGridTextColumn Header="সাবেক খতিয়ান নং" Binding="{Binding SabekKhatian, Converter={StaticResource BanglaNumConverter}}" Width="110"/>
                                            <DataGridTextColumn Header="দাগের মোট জমি (একর)" Binding="{Binding TotalPlotArea, Converter={StaticResource BanglaNumConverter}, ConverterParameter='0.0000'}" Width="140"/>
                                            <DataGridTextColumn Header="খতিয়ানের অংশ" Binding="{Binding KhatianShare, Converter={StaticResource BanglaNumConverter}, ConverterParameter='0.0000'}" Width="115"/>
                                            <DataGridTextColumn Header="অত্র খতিয়ানে জমি (একর)" Binding="{Binding KhatianPlotArea, Converter={StaticResource BanglaNumConverter}, ConverterParameter='0.0000'}" Width="145"/>
                                            <!-- Dynamic 3-part Land Classification with TextWrapping -->
                                            <DataGridTextColumn Header="৪(ক) কৃষি" Binding="{Binding AgriLandClass_4Ka}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="৪(খ) অকৃষি" Binding="{Binding NonAgriClass_4Kha}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="৪(গ) স্থানীয় নাম" Binding="{Binding LocalName_4Ga}" Width="130">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="দাগের মন্তব্য" Binding="{Binding PlotRemarks}" Width="220">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="LineHeight" Value="17"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Horizontal Scroll Slider for Plots & Land Classification Table -->
                                    <Grid x:Name="pnlPlotsHorizontalSlider" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="↔️ অনুভূমিক স্ক্রল:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="slPlotsHorizontalScroll" Grid.Column="1" Minimum="0" Maximum="100" Value="0"
                                                SmallChange="20" LargeChange="80" VerticalAlignment="Center"
