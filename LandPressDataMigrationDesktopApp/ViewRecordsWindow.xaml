<Window x:Class="LandPressDataMigrationDesktopApp.ViewRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="ভূমি রেকর্ড পরিদর্শন — Land Records Viewer (Side-by-Side Master-Detail)"
        Height="940" Width="1500"
        MinHeight="750" MinWidth="1150"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="{StaticResource AppFontPrimary}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Field Label Style (15px Semi-Bold) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Search TextBox Style (16px) -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Search ComboBox Style (16px, dropdown values 16px bold) -->
        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (15px bold) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Modern Style with Proper Spacing and Scaled Typography -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeInsetBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ThemeInsetBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style (18px Bold) -->
        <Style x:Key="PreviewSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Preview Property Label Style (15px Semi-Bold) -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Preview Property Value Style (16px Bold) -->
        <Style x:Key="PropVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Header -->
            <RowDefinition Height="*"/>    <!-- 1: Full-Height Side-by-Side Master-Detail Area -->
            <RowDefinition Height="Auto"/> <!-- 2: Bottom Status Footer -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP HEADER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle with Scaled Typography -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="8" Background="#065F46" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ভূমি রেকর্ড পরিদর্শন — Land Records Viewer" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                            <Border Background="#0D9488" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CORE 4103 DB" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="bdActiveMouzaBadge" Background="#1D4ED8" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="txtActiveMouzaBadge" Text="মৌজা: " Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DLRSLSINF_4103PRSDB এর সংরক্ষিত খতিয়ান, মালিক ও দাগ ভিত্তিক ভূমি রেকর্ড অনুসন্ধান ও পূর্ণাঙ্গ বিবরণী"
                                   Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Theme Toggle & Close Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnThemeToggle" Style="{StaticResource ActionBtn}" Padding="14,6" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,6,0" FontSize="13.5"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClose" Content="✖ বন্ধ করুন" Style="{StaticResource ActionBtn}" Background="#475569" Padding="16,6" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: FULL-HEIGHT SIDE-BY-SIDE MASTER-DETAIL AREA ================= -->
        <Grid Grid.Row="1" Background="{DynamicResource ThemeInsetBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="490" MinWidth="420" MaxWidth="750"/> <!-- Col 0: Left Pane (Filters Top + Master List) -->
                <ColumnDefinition Width="6"/>                                   <!-- Col 1: Vertical GridSplitter -->
                <ColumnDefinition Width="*"/>                                   <!-- Col 2: Right Pane (Full Height Preview) -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANE: FILTERS (AT TOP) + MASTER KHATIAN LIST ── -->
            <Grid Grid.Column="0" Margin="12,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top: 7 Search Filters Card -->
                    <RowDefinition Height="*"/>    <!-- Bottom: Master Khatian List DataGrid -->
                </Grid.RowDefinitions>

                <!-- ================= 7 SEARCH FILTERS CARD ================= -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="🔍 অনুসন্ধান ও ফিল্টার" Style="{StaticResource PreviewSectionHeader}" Margin="0,0,0,10"/>

                        <!-- Row 1: বিভাগ ও জেলা -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="বিভাগ:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbDivision" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbDivision_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="জেলা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbDistrict" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbDistrict_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: উপজেলা/থানা ও মৌজা -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="উপজেলা/থানা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbUpazila" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbUpazila_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="মৌজা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbMouza" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbMouza_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: জরিপ ও বর্তমান খতিয়ান -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="জরিপ:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSurvey" Style="{StaticResource SearchComboBox}">
                                    <ComboBoxItem Content="201901 - বিডিএস (BDS)" Tag="201901" IsSelected="True"/>
                                    <ComboBoxItem Content="সব জরিপ / All Surveys" Tag="%"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="বর্তমান খতিয়ান:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCurrentKhatian" Style="{StaticResource SearchTextBox}" ToolTip="নির্দিষ্ট খতিয়ান নম্বর দিয়ে খুঁজতে পারেন"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: মালিকের নাম -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="মালিকের নাম:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtOwner" Style="{StaticResource SearchTextBox}" ToolTip="মালিকের নাম দিয়ে খুঁজতে পারেন"/>
                        </StackPanel>

                        <!-- Row 5: Action Buttons (15px bold) -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnSearch" Content="🔍 খুঁজুন / Search" Style="{StaticResource ActionBtn}"
                                    Background="#059669" Margin="0,0,8,0" Click="BtnSearch_Click"/>
                            <Button Grid.Column="1" x:Name="btnReset" Content="🔄 রিসেট" Style="{StaticResource ActionBtn}"
                                    Background="#64748B" Padding="14,8" Click="BtnReset_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ================= MASTER KHATIAN LIST ================= -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Master List Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 খতিয়ান তালিকা" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                <Border x:Name="bdKhatianBadge" Background="#0284C7" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtKhatianCount" Text="০টি" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="btnExportKhatiansCsv" Content="📊 CSV"
                                    Style="{StaticResource ActionBtn}" Background="{DynamicResource ThemeInsetBg}"
                                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    Foreground="{DynamicResource ThemeTextPrimary}" Padding="12,5" FontSize="13"
                                    Click="BtnExportKhatiansCsv_Click"/>
                        </Grid>

                        <!-- Master DataGrid: Serial Number, Current Khatian, Owners, and Status -->
                        <DataGrid Grid.Row="1" x:Name="dgKhatians" Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="DgKhatians_SelectionChanged">
                            <DataGrid.Columns>
                                <!-- Serial Number Column on Left -->
                                <DataGridTextColumn Header="#" Binding="{Binding SlNo}" Width="50"/>
                                <DataGridTextColumn Header="বর্তমান খতিয়ান" Binding="{Binding CurrentKhatian}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="মালিকগণ" Binding="{Binding AllOwnerNames}" Width="*"/>
                                <DataGridTextColumn Header="অবস্থা" Binding="{Binding KhatianStatus}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RESIZABLE VERTICAL SPLITTER ── -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource ThemeCardBorder}" Cursor="SizeWE" ToolTip="ড্র্যাগ করে দুই পাশের আকার পরিবর্তন করুন"/>

            <!-- ── RIGHT PANE: ALL-IN-ONE KHATIAN PREVIEW (NO TABS) - FULL HEIGHT ── -->
            <Border Grid.Column="2" Background="{DynamicResource ThemeCardBg}" Margin="0,12,12,12"
                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Preview Header Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Preview Content -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtSelectedKhatianHeader" Text="🔍 নির্বাচিত খতিয়ানের পূর্ণাঙ্গ বিবরণী (Preview)"
                                   Style="{StaticResource PreviewSectionHeader}" Margin="0" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" x:Name="btnExportDetailsCsv" Content="📊 সম্পূর্ণ বিবরণী CSV এক্সপোর্ট"
                                Style="{StaticResource ActionBtn}" Background="{DynamicResource ThemeInsetBg}"
                                BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource ThemeTextPrimary}" Padding="16,6" FontSize="13.5"
                                Click="BtnExportDetailsCsv_Click"/>
                    </Grid>

                    <!-- Empty State Placeholder (when no khatian is selected) -->
                    <Border Grid.Row="1" x:Name="pnlEmptyPreview" Background="{DynamicResource ThemeInsetBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="কোনো খতিয়ান নির্বাচিত নেই" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="👈 বামের তালিকা থেকে যে কোনো একটি খতিয়ান নির্বাচন করুন, এখানে তার পূর্ণাঙ্গ বিবরণী দৃশ্যমান হবে।"
                                       FontSize="14" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Single-Page Preview Content -->
                    <ScrollViewer Grid.Row="1" x:Name="pnlPreviewContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,0">

                            <!-- ================= SECTION 1: KHATIAN IDENTIFICATION & OVERVIEW CARD ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="📋 খতিয়ান পরিচিতি ও সারাংশ" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <Border Background="#065F46" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="txtPrevBadgeStatus" Text="খসড়া" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Grid Row 1 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="বর্তমান খতিয়ান নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevCurrentKhatian" Text="—" Style="{StaticResource PropVal}" FontSize="17" Foreground="#0284C7"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="সাবেক খতিয়ান নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevFormerKhatian" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="এন্ট্রি খতিয়ান নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevEntryKhatian" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="নকশা শিট নং:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevSheet" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid Row 2 -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="মৌজার নাম:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevMouza" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="জরিপের ধরন:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevSurvey" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="মোট দাগ সংখ্যা:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevTotalPlots" Text="—" Style="{StaticResource PropVal}" Foreground="#059669"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="মোট জমির পরিমাণ (একর):" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevTotalArea" Text="—" Style="{StaticResource PropVal}" Foreground="#059669"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Grid Row 3 -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="খতিয়ানের ধরন:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevLandType" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="পর্চা শিরোনাম:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevPorchaTitle" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="মন্তব্য ও বিবরণ:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtPrevKhatianRemarks" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 2: OWNERS TABLE ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👥 মালিকগণের বিবরণ (Owners)" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <TextBlock Grid.Column="1" x:Name="txtOwnerCount" Text="মালিক সংখ্যা: ০ জন" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <DataGrid x:Name="dgOwners" Style="{StaticResource ModernDataGrid}" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <!-- Serial Number on Left -->
                                            <DataGridTextColumn Header="#" Binding="{Binding SlNo}" Width="50"/>
                                            <DataGridTextColumn Header="মালিকের নাম" Binding="{Binding OwnerName}" Width="190" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="পিতা / স্বামীর নাম" Binding="{Binding FatherName}" Width="170"/>
                                            <DataGridTextColumn Header="মাতার নাম" Binding="{Binding MotherName}" Width="150"/>
                                            <DataGridTextColumn Header="স্বামী / স্ত্রী" Binding="{Binding SpouseName}" Width="130"/>
                                            <DataGridTextColumn Header="লিঙ্গ" Binding="{Binding Gender}" Width="75"/>
                                            <DataGridTextColumn Header="এনআইডি নম্বর" Binding="{Binding Nid}" Width="140"/>
                                            <DataGridTextColumn Header="জন্ম নিবন্ধন নং" Binding="{Binding BirthReg}" Width="130"/>
                                            <DataGridTextColumn Header="মোবাইল" Binding="{Binding Phone}" Width="115"/>
                                            <DataGridTextColumn Header="ঠিকানা" Binding="{Binding Address}" Width="220"/>
                                            <DataGridTextColumn Header="অংশ / জমির পরিমাণ" Binding="{Binding OwnerShareArea, StringFormat={}{0:0.0000}}" Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 3: PLOTS & LAND CLASSIFICATION ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🗺️ দাগ ও জমির শ্রেণী (Plots &amp; Land Classification)" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                        <TextBlock Grid.Column="1" x:Name="txtPlotCount" Text="দাগ সংখ্যা: ০টি" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>

                                    <DataGrid x:Name="dgPlots" Style="{StaticResource ModernDataGrid}" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <!-- Serial Number on Left -->
                                            <DataGridTextColumn Header="#" Binding="{Binding SlNo}" Width="50"/>
                                            <DataGridTextColumn Header="বর্তমান দাগ নং" Binding="{Binding CurrentPlot}" Width="120" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="সাবেক দাগ নং" Binding="{Binding FormerPlot}" Width="105"/>
                                            <DataGridTextColumn Header="সি.এস. দাগ নং" Binding="{Binding CsPlot}" Width="100"/>
                                            <DataGridTextColumn Header="সাবেক খতিয়ান নং" Binding="{Binding SabekKhatian}" Width="110"/>
                                            <DataGridTextColumn Header="দাগের মোট জমি (একর)" Binding="{Binding TotalPlotArea, StringFormat={}{0:0.0000}}" Width="140"/>
                                            <DataGridTextColumn Header="খতিয়ানের অংশ" Binding="{Binding KhatianShare, StringFormat={}{0:0.0000}}" Width="115"/>
                                            <DataGridTextColumn Header="অত্র খতিয়ানে জমি (একর)" Binding="{Binding KhatianPlotArea, StringFormat={}{0:0.0000}}" Width="145"/>
                                            <!-- Dynamic 3-part Land Classification -->
                                            <DataGridTextColumn Header="৪(ক) কৃষি" Binding="{Binding AgriLandClass_4Ka}" Width="120"/>
                                            <DataGridTextColumn Header="৪(খ) অকৃষি" Binding="{Binding NonAgriLandClass_4Kha}" Width="120"/>
                                            <DataGridTextColumn Header="৪(গ) স্থানীয় নাম" Binding="{Binding LocalName_4Ga}" Width="130"/>
                                            <DataGridTextColumn Header="দাগের মন্তব্য" Binding="{Binding PlotRemarks}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ================= SECTION 4: AUDIT TRAIL & SYSTEM METADATA ================= -->
                            <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="8" Padding="18,14">
                                <StackPanel>
                                    <TextBlock Text="🛡️ সিস্টেম অডিট ও ট্রেইল (System Audit &amp; Metadata)" Style="{StaticResource PreviewSectionHeader}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="এন্ট্রি ইউজার আইডি:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditUserId" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="সিল আইডি ও বিবরণ:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditSeal" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="টার্মিনাল আইডি:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditTerminal" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="এন্ট্রি তারিখ ও সময়:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditTime" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="খতিয়ান নোট:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditNote" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="বিশেষ মন্তব্য:" Style="{StaticResource PropLabel}"/>
                                            <TextBlock x:Name="txtAuditRemarks" Text="—" Style="{StaticResource PropVal}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 2: BOTTOM STATUS & DETAIL BANNER ================= -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeFooterBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" Text="প্রস্তুত: অনুগ্রহ করে বিভাগ, জেলা, উপজেলা এবং মৌজা নির্বাচন করে খুঁজুন বাটনে ক্লিক করুন"
                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="txtDbInfo" Text="Database: DLRSLSINF_4103PRSDB"
                           Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= 3: FULL-SCREEN LOADING OVERLAY ================= -->
        <Grid x:Name="loadingOverlay" Background="#80000000" Visibility="Collapsed" Grid.RowSpan="3">
            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                    CornerRadius="10" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,18" Foreground="#059669"/>
                    <TextBlock x:Name="txtLoadingMessage" Text="অনুগ্রহ করে অপেক্ষা করুন..." FontWeight="Bold" FontSize="16"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="ডাটাবেজ থেকে ভূমি রেকর্ড সংগ্রহ ও লোড করা হচ্ছে..." FontSize="13.5"
                               HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
