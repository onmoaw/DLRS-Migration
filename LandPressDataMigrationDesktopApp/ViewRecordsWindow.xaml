<Window x:Class="LandPressDataMigrationDesktopApp.ViewRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="ভূমির রেকর্ড অনুসন্ধান ও প্রদর্শন — View Records"
        Height="780" Width="1220"
        MinHeight="640" MinWidth="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="Segoe UI, Kalpurush, Vrinda, Nirmala UI, Arial"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Shared Field Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Shared Input TextBox Style -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Shared ComboBox Style -->
        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Form Search Filter Card (From Image) -->
            <RowDefinition Height="*"/>    <!-- 2: Results DataGrid -->
            <RowDefinition Height="Auto"/> <!-- 3: Bottom Status Footer -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP HEADER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#065F46" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🔎" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ভূমির রেকর্ড অনুসন্ধান ও বিবরণী" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="18" FontWeight="Bold"/>
                            <Border Background="#0D9488" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="LAND RECORDS VIEWER" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="খতিয়ান, দাগ, মালিকানা ও অন্যান্য তথ্যাদি ফিল্টার ও অনুসন্ধান করুন (ডেমো ডাটা প্রদর্শিত)"
                                   Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Utilities & Theme Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnFillDemoData" Content="⚡ নমুনা তথ্য পূরণ" Style="{StaticResource ActionBtn}"
                            Background="#0284C7" Padding="12,6" Margin="0,0,8,0" Click="BtnFillDemoData_Click"
                            ToolTip="ফিল্টারে নমুনা তথ্য স্বয়ংক্রিয়ভাবে ইনপুট করুন"/>

                    <Button x:Name="btnThemeToggle" Style="{StaticResource ActionBtn}" Padding="12,6" Margin="0,0,8,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,5,0" FontSize="12"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClose" Content="বন্ধ করুন" Style="{StaticResource ActionBtn}" Background="#475569" Padding="14,6" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: SEARCH FILTER CARD (MATCHING USER SCREENSHOT) ================= -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>

                <!-- 4-Column Responsive Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═════════ ROW 1 ═════════ -->
                    <!-- Col 1: বিভাগ -->
                    <Grid Grid.Column="0" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="বিভাগ:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbDivision" Grid.Column="1" Style="{StaticResource SearchComboBox}">
                            <ComboBoxItem Content="নির্বাচন করুন" IsSelected="True"/>
                            <ComboBoxItem Content="সিলেট"/>
                            <ComboBoxItem Content="ঢাকা"/>
                            <ComboBoxItem Content="চট্টগ্রাম"/>
                            <ComboBoxItem Content="রাজশাহী"/>
                            <ComboBoxItem Content="খুলনা"/>
                            <ComboBoxItem Content="বরিশাল"/>
                            <ComboBoxItem Content="রংপুর"/>
                            <ComboBoxItem Content="ময়মনসিংহ"/>
                        </ComboBox>
                    </Grid>

                    <!-- Col 2: জেলা -->
                    <Grid Grid.Column="1" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="জেলা:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbDistrict" Grid.Column="1" Style="{StaticResource SearchComboBox}">
                            <ComboBoxItem Content="নির্বাচন করুন" IsSelected="True"/>
                            <ComboBoxItem Content="সিলেট"/>
                            <ComboBoxItem Content="মৌলভীবাজার"/>
                            <ComboBoxItem Content="হবিগঞ্জ"/>
                            <ComboBoxItem Content="সুনামগঞ্জ"/>
                            <ComboBoxItem Content="ঢাকা"/>
                            <ComboBoxItem Content="চট্টগ্রাম"/>
                        </ComboBox>
                    </Grid>

                    <!-- Col 3: জরিপ -->
                    <Grid Grid.Column="2" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="জরিপ:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbSurvey" Grid.Column="1" Style="{StaticResource SearchComboBox}">
                            <ComboBoxItem Content="নির্বাচন করুন" IsSelected="True"/>
                            <ComboBoxItem Content="বি.এস. (BS)"/>
                            <ComboBoxItem Content="আর.এস. (RS)"/>
                            <ComboBoxItem Content="সি.এস. (CS)"/>
                            <ComboBoxItem Content="এস.এ. (SA)"/>
                            <ComboBoxItem Content="দিয়ারা (Diara)"/>
                            <ComboBoxItem Content="পেটি (Peti)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Col 4: উপজেলা/থানা -->
                    <Grid Grid.Column="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="উপজেলা/থানা:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbUpazila" Grid.Column="1" Style="{StaticResource SearchComboBox}">
                            <ComboBoxItem Content="নির্বাচন করুন" IsSelected="True"/>
                            <ComboBoxItem Content="সিলেট সদর"/>
                            <ComboBoxItem Content="গোলাপগঞ্জ"/>
                            <ComboBoxItem Content="বিয়ানীবাজার"/>
                            <ComboBoxItem Content="বিশ্বনাথ"/>
                            <ComboBoxItem Content="ফেঞ্চুগঞ্জ"/>
                            <ComboBoxItem Content="বালাগঞ্জ"/>
                        </ComboBox>
                    </Grid>
                </Grid>

                <!-- ═════════ ROW 2 ═════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: মৌজা -->
                    <Grid Grid.Column="0" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="মৌজা:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cmbMouza" Grid.Column="1" Style="{StaticResource SearchComboBox}">
                            <ComboBoxItem Content="নির্বাচন করুন" IsSelected="True"/>
                            <ComboBoxItem Content="আম্বরখানা (০১)"/>
                            <ComboBoxItem Content="লামাবাজার (০২)"/>
                            <ComboBoxItem Content="উপশহর (০৩)"/>
                            <ComboBoxItem Content="শিবগঞ্জ (০৪)"/>
                            <ComboBoxItem Content="পাঠানটুলা (০৫)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Col 2: বর্তমান খতিয়ান -->
                    <Grid Grid.Column="1" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="বর্তমান খতিয়ান:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCurrentKhatian" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 3: মালিক -->
                    <Grid Grid.Column="2" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="মালিক:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtOwner" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 4: পিতা -->
                    <Grid Grid.Column="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="পিতা:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFather" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>
                </Grid>

                <!-- ═════════ ROW 3 ═════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: মাতা -->
                    <Grid Grid.Column="0" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="মাতা:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMother" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 2: এন. আইডি -->
                    <Grid Grid.Column="1" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="এন. আইডি:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNid" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 3: জন্ম নিবন্ধন -->
                    <Grid Grid.Column="2" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="জন্ম নিবন্ধন:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtBirthReg" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 4: সাবেক খতিয়ান -->
                    <Grid Grid.Column="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="সাবেক খতিয়ান:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFormerKhatian" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>
                </Grid>

                <!-- ═════════ ROW 4 ═════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: বর্তমান দাগ -->
                    <Grid Grid.Column="0" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="বর্তমান দাগ:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCurrentPlot" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 2: সাবেক দাগ -->
                    <Grid Grid.Column="1" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="সাবেক দাগ:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtFormerPlot" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 3: সি.এস.দাগ -->
                    <Grid Grid.Column="2" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="সি.এস.দাগ:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtCsPlot" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 4: মালিকের ঠিকানা -->
                    <Grid Grid.Column="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="মালিকের ঠিকানা:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtOwnerAddress" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>
                </Grid>

                <!-- ═════════ ROW 5 ═════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: স্বামী / স্ত্রী -->
                    <Grid Grid.Column="0" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="স্বামী / স্ত্রী:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtSpouse" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 2: মোবাইল নম্বর -->
                    <Grid Grid.Column="1" Margin="0,0,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="মোবাইল নম্বর:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMobile" Grid.Column="1" Style="{StaticResource SearchTextBox}"/>
                    </Grid>

                    <!-- Col 3 & 4: Empty space in Row 5 -->
                    <Grid Grid.Column="2" Margin="0,0,14,8"/>
                    <Grid Grid.Column="3" Margin="0,0,0,8"/>
                </Grid>

                <!-- ═════════ ROW 6: ACTION BUTTONS (EXACT GREEN BUTTON AS IN SCREENSHOT) ═════════ -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Status note & Reset -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnReset" Content="🔄 ফিল্টার পরিষ্কার (Reset)" Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource ThemeTextSecondary}" Padding="14,8" Click="BtnReset_Click"/>

                        <TextBlock x:Name="txtSearchHint" Text="সকল ফিল্টার খালি রেখে 'ফলাফল দেখাও' চাপলে সকল ডেমো রেকর্ড প্রদর্শিত হবে।"
                                   Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>

                    <!-- Right: GREEN "ফলাফল দেখাও" BUTTON (Matching provided screenshot) -->
                    <Button x:Name="btnShowResults" Grid.Column="1" MinWidth="180" Height="40" Style="{StaticResource ActionBtn}"
                            Background="#064E3B" Padding="28,8" Click="BtnShowResults_Click" IsDefault="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ফলাফল দেখাও" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

        <!-- ================= 2: RESULTS DATAGRID ================= -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeInsetBg}" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Results Header Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊 অনুসন্ধানের ফলাফল (Records Table)" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="14"/>
                        <Border x:Name="bdRecordBadge" Background="#0284C7" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtRecordCount" Text="মোট রেকর্ড: ৬ টি" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 কোনো রেকর্ডে ক্লিক করলে নিচে বিস্তারিত দৃশ্যমান হবে" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button x:Name="btnExportCsv" Content="📥 CSV এক্সপোর্ট" Style="{StaticResource ActionBtn}"
                                Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                Foreground="{DynamicResource ThemeTextPrimary}" Padding="10,5" FontSize="11.5" Click="BtnExportCsv_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8">
                    <DataGrid x:Name="dgRecords"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ThemeCardBorder}"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="{DynamicResource ThemeInsetBg}"
                              Foreground="{DynamicResource ThemeTextPrimary}"
                              BorderThickness="0"
                              FontSize="12.5"
                              RowHeight="34"
                              SelectionChanged="DgRecords_SelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource ThemeHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding SlNo}" Width="45"/>
                            <DataGridTextColumn Header="মৌজা" Binding="{Binding Mouza}" Width="120"/>
                            <DataGridTextColumn Header="জরিপ" Binding="{Binding SurveyType}" Width="75"/>
                            <DataGridTextColumn Header="বর্তমান খতিয়ান" Binding="{Binding CurrentKhatian}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="সাবেক খতিয়ান" Binding="{Binding FormerKhatian}" Width="105"/>
                            <DataGridTextColumn Header="বর্তমান দাগ" Binding="{Binding CurrentPlot}" Width="95" FontWeight="Bold"/>
                            <DataGridTextColumn Header="সাবেক দাগ" Binding="{Binding FormerPlot}" Width="85"/>
                            <DataGridTextColumn Header="সি.এস. দাগ" Binding="{Binding CsPlot}" Width="85"/>
                            <DataGridTextColumn Header="মালিকের নাম" Binding="{Binding OwnerName}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="পিতা / স্বামীর নাম" Binding="{Binding FatherName}" Width="150"/>
                            <DataGridTextColumn Header="মাতার নাম" Binding="{Binding MotherName}" Width="130"/>
                            <DataGridTextColumn Header="এন.আইডি" Binding="{Binding Nid}" Width="140"/>
                            <DataGridTextColumn Header="জমির শ্রেণী" Binding="{Binding LandClass}" Width="85"/>
                            <DataGridTextColumn Header="জমির পরিমাণ" Binding="{Binding LandAreaAcre}" Width="95"/>
                            <DataGridTextColumn Header="অংশ" Binding="{Binding Share}" Width="70"/>
                            <DataGridTextColumn Header="ঠিকানা" Binding="{Binding Address}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 3: BOTTOM STATUS & DETAIL BANNER ================= -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeFooterBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌 নির্বাচিত রেকর্ড: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtSelectedRecordDetail" Text="কোনো রেকর্ড নির্বাচিত নেই (তালিকা থেকে যেকোনো সারিতে ক্লিক করুন)"
                               Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="DLRS Data Migration System • Demo Records Engine"
                           Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
