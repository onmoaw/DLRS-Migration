            </Border>

            <!-- ================= PANEL 2: KHATIAN VIEW (OFFICIAL BANGLADESH FORM 5462 RDLC LAYOUT) ================= -->
            <Border x:Name="pnlKhatianView" Background="{DynamicResource ThemeCardBg}" Margin="0,12,12,12"
                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Toolbar & Zoom Controls -->
                        <RowDefinition Height="*"/>    <!-- Scrollable & Zoomable Document Container -->
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar / Zoom Controls (Normal Mode) -->
                    <Border x:Name="pnlKhatianNormalToolbar" Grid.Row="0" Background="{DynamicResource ThemeInsetBg}" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Selected Khatian Badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="bdKhatianHeroPill" Background="#0284C7" CornerRadius="6" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtKhatianViewHeroBadge" Text="খতিয়ান: —" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="📜 বাংলাদেশ ফরম নং ৫৪৬২ — খতিয়ান ফরম (পর্চা)" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right: Zoom Controls, Fullscreen & Admin Print Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Zoom Controls -->
                                <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
