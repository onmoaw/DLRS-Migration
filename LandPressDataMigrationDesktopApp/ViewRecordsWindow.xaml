<Window x:Class="LandPressDataMigrationDesktopApp.ViewRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LandPressDataMigrationDesktopApp"
        mc:Ignorable="d"
        Title="ভূমি রেকর্ড পরিদর্শন — Land Records Viewer (Side-by-Side Master-Detail)"
        Height="940" Width="1500"
        MinHeight="750" MinWidth="1150"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Icon="/Assets/DLRS-Migration App Icon.png"
        Background="{DynamicResource ThemeWindowBg}"
        FontFamily="{StaticResource AppFontPrimary}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Bangla Number Converter Resource -->
        <local:BanglaNumberConverter x:Key="BanglaNumConverter"/>

        <!-- Field Label Style (15px Semi-Bold) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Search TextBox Style (16px) -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Search ComboBox Style (16px, dropdown values 16px bold) -->
        <Style x:Key="SearchComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style (15px bold) -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Switcher Segmented RadioButton Style -->
        <Style x:Key="ViewTabSegmentBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="ReportViewTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThemeInsetBg}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#0369A1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- High-Visibility Selected Khatian Row Style (Master List) -->
        <Style x:Key="KhatianRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="4,0,0,1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Resources>
                <!-- Keep vibrant selection highlight even when focus moves to right preview panel -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0284C7"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0284C7"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#F59E0B"/> <!-- 4px golden accent bar on left -->
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeInsetBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Modern Style with Proper Spacing and Scaled Typography -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource ThemeInsetBg}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource ThemeInsetBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style (18px Bold) -->
        <Style x:Key="PreviewSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Preview Property Label Style (15px Semi-Bold) -->
        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Preview Property Value Style (16px Bold) -->
        <Style x:Key="PropVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Top Header -->
            <RowDefinition Height="*"/>    <!-- 1: Full-Height Side-by-Side Master-Detail Area -->
            <RowDefinition Height="Auto"/> <!-- 2: Bottom Status Footer -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP HEADER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle with Scaled Typography -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="8" Background="#065F46" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ভূমি রেকর্ড পরিদর্শন — Land Records Viewer" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" FontWeight="Bold"/>
                            <Border Background="#0D9488" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CORE 4103 DB" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="bdActiveMouzaBadge" Background="#1D4ED8" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="txtActiveMouzaBadge" Text="মৌজা: " Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DLRSLSINF_4103PRSDB এর সংরক্ষিত খতিয়ান, মালিক ও দাগ ভিত্তিক ভূমি রেকর্ড অনুসন্ধান ও পূর্ণাঙ্গ বিবরণী"
                                   Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: View Mode Tabs, Theme Toggle & Close Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- View Mode Selector Segmented Tabs -->
                    <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="3" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbSoftwareView" Content="💻 সফটওয়্যার ভিউ" Style="{StaticResource ViewTabSegmentBtn}"
                                         IsChecked="True" Checked="ViewTab_Checked"/>
                            <RadioButton x:Name="rbKhatianView" Content="📜 খতিয়ান ভিউ (পর্চা)" Style="{StaticResource ViewTabSegmentBtn}"
                                         Margin="4,0,0,0" Checked="ViewTab_Checked"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnThemeToggle" Style="{StaticResource ActionBtn}" Padding="14,6" Margin="0,0,10,0"
                            Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}" Click="BtnThemeToggle_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtThemeIcon" Text="☀️" Margin="0,0,6,0" FontSize="13.5"/>
                            <TextBlock x:Name="txtThemeLabel" Text="Light" FontSize="13.5" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnClose" Content="✖ বন্ধ করুন" Style="{StaticResource ActionBtn}" Background="#475569" Padding="16,6" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: FULL-HEIGHT SIDE-BY-SIDE MASTER-DETAIL AREA ================= -->
        <Grid Grid.Row="1" Background="{DynamicResource ThemeInsetBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="490" MinWidth="420" MaxWidth="750"/> <!-- Col 0: Left Pane (Filters Top + Master List) -->
                <ColumnDefinition Width="6"/>                                   <!-- Col 1: Vertical GridSplitter -->
                <ColumnDefinition Width="*"/>                                   <!-- Col 2: Right Pane (Full Height Preview) -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANE: FILTERS (AT TOP) + MASTER KHATIAN LIST ── -->
            <Grid Grid.Column="0" Margin="12,12,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top: 7 Search Filters Card -->
                    <RowDefinition Height="*"/>    <!-- Bottom: Master Khatian List DataGrid -->
                </Grid.RowDefinitions>

                <!-- ================= 7 SEARCH FILTERS CARD ================= -->
                <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="🔍 অনুসন্ধান ও ফিল্টার" Style="{StaticResource PreviewSectionHeader}" Margin="0,0,0,10"/>

                        <!-- Row 1: বিভাগ ও জেলা -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="বিভাগ:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbDivision" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbDivision_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="জেলা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbDistrict" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbDistrict_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: উপজেলা/থানা ও মৌজা -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="উপজেলা/থানা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbUpazila" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbUpazila_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="মৌজা:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbMouza" Style="{StaticResource SearchComboBox}" SelectionChanged="CmbMouza_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: জরিপ ও বর্তমান খতিয়ান -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="জরিপ:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbSurvey" Style="{StaticResource SearchComboBox}">
                                    <ComboBoxItem Content="২০১৯০১ - বিডিএস (BDS)" Tag="201901" IsSelected="True"/>
                                    <ComboBoxItem Content="সব জরিপ / All Surveys" Tag="%"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="বর্তমান খতিয়ান:" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtCurrentKhatian" Style="{StaticResource SearchTextBox}" ToolTip="নির্দিষ্ট খতিয়ান নম্বর দিয়ে খুঁজতে পারেন (বাংলা বা ইংরেজি সংখ্যা)"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: মালিকের নাম -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="মালিকের নাম:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtOwner" Style="{StaticResource SearchTextBox}" ToolTip="মালিকের নাম দিয়ে খুঁজতে পারেন"/>
                        </StackPanel>

                        <!-- Row 5: Action Buttons (15px bold) -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnSearch" Content="🔍 খুঁজুন / Search" Style="{StaticResource ActionBtn}"
                                    Background="#059669" Margin="0,0,8,0" Click="BtnSearch_Click"/>
                            <Button Grid.Column="1" x:Name="btnReset" Content="🔄 রিসেট" Style="{StaticResource ActionBtn}"
                                    Background="#64748B" Padding="14,8" Click="BtnReset_Click"/>
                        </Grid>

                        <!-- Sleek Search Indeterminate Progress Bar (Adjusted to Filter Card) -->
                        <ProgressBar x:Name="searchProgressBar" Height="4" Margin="0,10,0,0" IsIndeterminate="True"
                                     Foreground="#059669" Background="{DynamicResource ThemeInsetBg}" BorderThickness="0"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ================= MASTER KHATIAN LIST ================= -->
                <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Master List Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 খতিয়ান তালিকা" Style="{StaticResource PreviewSectionHeader}" Margin="0"/>
                                <Border x:Name="bdKhatianBadge" Background="#0284C7" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtKhatianCount" Text="০টি" Foreground="White" FontSize="13" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="btnExportKhatiansCsv" Content="📊 CSV"
                                     Style="{StaticResource ActionBtn}" Background="{DynamicResource ThemeInsetBg}"
                                     BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                     Foreground="{DynamicResource ThemeTextPrimary}" Padding="12,5" FontSize="13"
                                     Click="BtnExportKhatiansCsv_Click"/>
                        </Grid>

                        <!-- Master DataGrid and UI-Adjusted Inline List Loader -->
                        <Grid Grid.Row="1">
                            <!-- Master DataGrid: Serial Number (# in Bangla), Current Khatian (Bangla), Owners, and Status -->
                            <DataGrid x:Name="dgKhatians" Style="{StaticResource ModernDataGrid}"
                                      RowStyle="{StaticResource KhatianRowStyle}"
                                      SelectionChanged="DgKhatians_SelectionChanged">
                                <DataGrid.Columns>
                                    <!-- Serial Number Column on Left in Bangla -->
                                    <DataGridTextColumn Header="#" Binding="{Binding SlNo, Converter={StaticResource BanglaNumConverter}}" Width="50"/>
                                    <!-- Current Khatian in Bangla -->
                                    <DataGridTextColumn Header="বর্তমান খতিয়ান" Binding="{Binding CurrentKhatian, Converter={StaticResource BanglaNumConverter}}" Width="120" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="মালিকগণ" Binding="{Binding AllOwnerNames}" Width="*"/>
                                    <DataGridTextColumn Header="অবস্থা" Binding="{Binding KhatianStatus}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Modern UI-Adjusted Master List Inline Loading Overlay -->
                            <Border x:Name="pnlListLoading" Background="{DynamicResource ThemeCardBg}" Opacity="0.95"
                                    BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                    CornerRadius="6" Visibility="Collapsed" Panel.ZIndex="10">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="#E0F2FE" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ProgressBar IsIndeterminate="True" Width="200" Height="5" Foreground="#0284C7"
                                                 Background="{DynamicResource ThemeInsetBg}" BorderThickness="0" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="txtListLoadingTitle" Text="রেকর্ড অনুসন্ধান চলছে..." FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtListLoadingSub" Text="ডাটাবেজ থেকে তথ্য আনা হচ্ছে, অনুগ্রহ করে অপেক্ষা করুন..." FontSize="13"
                                               Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RESIZABLE VERTICAL SPLITTER ── -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource ThemeCardBorder}" Cursor="SizeWE" ToolTip="ড্র্যাগ করে দুই পাশের আকার পরিবর্তন করুন"/>

            <!-- ── RIGHT PANE: DUAL VIEW (SOFTWARE VIEW / KHATIAN VIEW) ── -->
            <Grid Grid.Column="2">
                <!-- ================= PANEL 1: SOFTWARE VIEW (DEFAULT) ================= -->
                <Border x:Name="pnlSoftwareView" Background="{DynamicResource ThemeCardBg}" Margin="0,12,12,12"
                        BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14"
                        Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Preview Header Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Preview Content -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header Bar with Prominently Highlighted Khatian Banner -->
