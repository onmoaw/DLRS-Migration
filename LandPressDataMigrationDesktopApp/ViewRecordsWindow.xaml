                                        Click="BtnKhatianPrint_Click" ToolTip="খতিয়ান প্রিন্ট করুন (Admin Only)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Fullscreen Top Navigation Bar (Shown only in Fullscreen Mode) -->
                    <Border x:Name="pnlFullscreenTopBar" Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" BorderBrush="#0284C7" BorderThickness="0,0,0,2"
                            Padding="14,8" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Left/Right Arrows + Khatian Number Dropdown -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnFsPrevKhatian" Content="◀" Width="38" Height="34" Padding="0" Margin="0,0,6,0"
                                        Style="{StaticResource ActionBtn}" Background="#0284C7" Foreground="White" FontSize="14" FontWeight="Bold"
                                        Click="BtnFsPrevKhatian_Click" ToolTip="পূর্ববর্তী খতিয়ান (Left Arrow)"/>

                                <ComboBox x:Name="cmbFsKhatianList" Width="230" Height="34" Style="{StaticResource SearchComboBox}"
                                          DisplayMemberPath="DisplayText" SelectionChanged="CmbFsKhatianList_SelectionChanged"
                                          ToolTip="নির্বাচিত ফিল্টারের খতিয়ান নম্বর তালিকা"/>

                                <Button x:Name="btnFsNextKhatian" Content="▶" Width="38" Height="34" Padding="0" Margin="6,0,12,0"
                                        Style="{StaticResource ActionBtn}" Background="#0284C7" Foreground="White" FontSize="14" FontWeight="Bold"
                                        Click="BtnFsNextKhatian_Click" ToolTip="পরবর্তী খতিয়ান (Right Arrow)"/>

                                <Border Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtFsKhatianPosition" Text="০ / ০" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Right: Zoom Controls, Print & Exit Fullscreen -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="➖" Width="28" Height="26" Padding="0" Margin="0,0,4,0"
                                                Style="{StaticResource ActionBtn}" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomOut_Click" ToolTip="জুম আউট"/>
                                        <TextBlock x:Name="txtFsZoomLevel" Text="১০০%" Width="46" TextAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        <Button Content="➕" Width="28" Height="26" Padding="0" Margin="4,0,6,0"
                                                Style="{StaticResource ActionBtn}" Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomIn_Click" ToolTip="জুম ইন"/>
                                        <Button Content="📐 প্রস্থে মিলান" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="4,0,0,0"
                                                Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomFitWidth_Click"/>
                                        <Button Content="🔄 ১০০%" Style="{StaticResource ActionBtn}" Padding="8,3" Margin="4,0,0,0"
                                                Background="{DynamicResource ThemeInsetBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1"
                                                Foreground="{DynamicResource ThemeTextPrimary}" FontSize="12" Click="BtnZoomReset_Click"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="btnFsPrint" Content="🖨️ প্রিন্ট করুন" Style="{StaticResource ActionBtn}"
                                        Background="#047857" Foreground="White" Padding="12,6" FontSize="13" Margin="0,0,8,0"
                                        Click="BtnKhatianPrint_Click" ToolTip="খতিয়ান প্রিন্ট করুন (Admin Only)"/>

                                <Button x:Name="btnExitFullscreen" Content="✖ সাধারণ ভিউ" Style="{StaticResource ActionBtn}"
                                        Background="#DC2626" Foreground="White" Padding="14,6" FontSize="13"
                                        Click="BtnExitFullscreen_Click" ToolTip="ফুলস্ক্রিন বন্ধ করে সাধারণ ভিউতে ফিরে যান (Esc)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Empty State for Khatian View -->
                    <Border Grid.Row="1" x:Name="pnlKhatianEmpty" Background="{DynamicResource ThemeInsetBg}" CornerRadius="8"
                            BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📜" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="কোনো খতিয়ান নির্বাচিত নেই" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="👈 বামের তালিকা থেকে একটি খতিয়ান নির্বাচন করুন, এখানে অফিসিয়াল খতিয়ান ফরম (পর্চা) দৃশ্যমান হবে।"
                                       FontSize="14" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Zoomable Document Viewer -->
                    <ScrollViewer Grid.Row="1" x:Name="svKhatianDoc" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#94A3B8" Visibility="Collapsed" PreviewMouseWheel="SvKhatianDoc_PreviewMouseWheel">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,18">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="stKhatianZoom" ScaleX="1.0" ScaleY="1.0"/>
                            </Grid.LayoutTransform>

                            <!-- Vector Paper Outline Layer -->
                            <Border Background="#64748B" Opacity="0.3" CornerRadius="2" Margin="3,3,-3,-3"/>

                            <!-- Printable Document Paper (A4 Landscape Form: 1122 x 794 px) -->
                            <Border x:Name="pnlKhatianDocSheet" Background="White" BorderBrush="#475569" BorderThickness="1"
                                    Width="1122" MinHeight="794" Padding="28,22,28,26" TextElement.Foreground="#0F172A"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
                                    TextOptions.TextHintingMode="Auto" RenderOptions.ClearTypeHint="Enabled"
                                    TextElement.FontFamily="Kalpurush, SolaimanLipi, Nirmala UI, Vrinda, Segoe UI">
                                <Border.Resources>
                                    <!-- High-Resolution DirectWrite Vector Text Typography Style -->
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                                        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                                        <Setter Property="TextOptions.TextHintingMode" Value="Auto"/>
                                        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
                                        <Setter Property="FontFamily" Value="Kalpurush, SolaimanLipi, Nirmala UI, Vrinda, Segoe UI"/>
                                        <Setter Property="SnapsToDevicePixels" Value="False"/>
                                    </Style>
                                </Border.Resources>

                                <StackPanel>
                                    <!-- ================= HEADER ROW: BANGLADESH FORM 5462, TITLE, SURVEY & STATUS BADGE ================= -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Top-Left: Form 5462 -->
                                        <TextBlock Grid.Column="0" Text="বাংলাদেশ ফরম নং ৫৪৬২ (সংশোধিত)" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#000000" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                        <!-- Center: Khatian No & Survey Name -->
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="খতিয়ান নং - " FontSize="22" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBlock x:Name="rptKhatianNo" Text="—" FontSize="22" FontWeight="Bold" Foreground="#000000"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBlock Text="জরিপের নাম: " FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                                                <TextBlock x:Name="rptSurveyName" Text="—" FontSize="13" FontWeight="Bold" Foreground="#000000"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Top-Right: QR Code & Status Box -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <!-- QR Code Vector Box -->
                                            <Border Width="50" Height="50" BorderBrush="#000000" BorderThickness="1" Background="White" Padding="2" VerticalAlignment="Center">
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas Width="40" Height="40">
                                                        <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Stroke="#000000" StrokeThickness="2" Fill="White"/>
                                                        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="26" Canvas.Top="2" Width="12" Height="12" Stroke="#000000" StrokeThickness="2" Fill="White"/>
                                                        <Rectangle Canvas.Left="29" Canvas.Top="5" Width="6" Height="6" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="2" Canvas.Top="26" Width="12" Height="12" Stroke="#000000" StrokeThickness="2" Fill="White"/>
                                                        <Rectangle Canvas.Left="5" Canvas.Top="29" Width="6" Height="6" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="17" Canvas.Top="3" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="21" Canvas.Top="3" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="17" Canvas.Top="7" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="19" Canvas.Top="11" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="3" Canvas.Top="17" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="7" Canvas.Top="17" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="11" Canvas.Top="19" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="15" Canvas.Top="16" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="19" Canvas.Top="18" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="23" Canvas.Top="16" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="27" Canvas.Top="18" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="31" Canvas.Top="16" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="35" Canvas.Top="19" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="16" Canvas.Top="23" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="21" Canvas.Top="24" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="26" Canvas.Top="22" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="32" Canvas.Top="24" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="17" Canvas.Top="28" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="23" Canvas.Top="30" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="28" Canvas.Top="28" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="34" Canvas.Top="30" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="18" Canvas.Top="34" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="24" Canvas.Top="35" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="29" Canvas.Top="34" Width="3" Height="3" Fill="#000000"/>
                                                        <Rectangle Canvas.Left="35" Canvas.Top="35" Width="3" Height="3" Fill="#000000"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>

                                            <!-- Official Status Badge Box -->
                                            <Border BorderBrush="#000000" BorderThickness="1.5" CornerRadius="0" Padding="8,5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="rptKhatianStatusPill" Text="বুঝারত স্তর -এর এন্ট্রি চলমান" FontSize="12.5" FontWeight="Bold" Foreground="#000000"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Hidden references for binding compatibility -->
                                        <TextBlock x:Name="rptFormerKhatianNo" Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- ================= ADMINISTRATIVE HIERARCHY (UNBORDERED HORIZONTAL ROW) ================= -->
                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="2.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="বিভাগ: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptDivision" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="জেলা: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptDistrict" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="উপজেলা/থানা: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptUpazila" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Text="মৌজা: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptMouza" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <TextBlock Text="জে. এল: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptJLNo" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                                            <TextBlock Text="শীট নং: " FontWeight="Bold" FontSize="11.5" Foreground="#000000"/>
                                            <TextBlock x:Name="rptSheetNo" Text="—" FontSize="11.5" Foreground="#000000"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ================= 13-COLUMN OFFICIAL TABLE (DevResource\KhotiyanPdf.pdf Match) ================= -->
                                    <Border BorderBrush="#000000" BorderThickness="1">
                                        <StackPanel>
                                            <!-- Table Header Grid -->
                                            <Grid Background="White">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/> <!-- Col 0: মালিকের বিবরণ -->
                                                    <ColumnDefinition Width="55"/>  <!-- Col 1: অংশ -->
                                                    <ColumnDefinition Width="70"/>  <!-- Col 2: সাবেক দাগ -->
                                                    <ColumnDefinition Width="70"/>  <!-- Col 3: বর্তমান দাগ -->
                                                    <ColumnDefinition Width="65"/>  <!-- Col 4: কৃষি -->
                                                    <ColumnDefinition Width="65"/>  <!-- Col 5: অকৃষি -->
                                                    <ColumnDefinition Width="75"/>  <!-- Col 6: স্থানীয় নাম -->
                                                    <ColumnDefinition Width="55"/>  <!-- Col 7: মোট জমি একর -->
                                                    <ColumnDefinition Width="65"/>  <!-- Col 8: মোট জমি অযুতাংশ -->
                                                    <ColumnDefinition Width="70"/>  <!-- Col 9: খতিয়ানের অংশ -->
                                                    <ColumnDefinition Width="55"/>  <!-- Col 10: অংশ অনুযায়ী একর -->
                                                    <ColumnDefinition Width="65"/>  <!-- Col 11: অংশ অনুযায়ী অযুতাংশ -->
                                                    <ColumnDefinition Width="126"/> <!-- Col 12: মন্তব্য -->
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34"/> <!-- Main Group Header -->
                                                    <RowDefinition Height="26"/> <!-- Sub-Header -->
                                                    <RowDefinition Height="22"/> <!-- Column Number (১ to ৮) -->
                                                </Grid.RowDefinitions>

                                                <!-- Col 0: মালিকের বিবরণ (RowSpan 2) -->
                                                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="4,2">
                                                    <TextBlock Text="মালিকের নাম, পিতা, মাতা, স্বামী /স্ত্রীর নাম(ব্যক্তি) ও&#x0a;ঠিকানা, জন্মনিবন্ধন/জাতীয় পরিচয় পত্র নম্বর(ব্যক্তি)"
                                                               FontSize="10" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" LineHeight="14"/>
                                                </Border>

                                                <!-- Col 1: মালিকানা অংশ (RowSpan 2) -->
                                                <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="মালিকানা&#x0a;অংশ" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Col 2-3: সাবেক ও বর্তমান দাগ নম্বর (ColSpan 2) -->
                                                <Border Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="সাবেক ও বর্তমান দাগ নম্বর" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Sub: সাবেক দাগ -->
                                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="সাবেক দাগ" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Sub: বর্তমান দাগ -->
                                                <Border Grid.Row="1" Grid.Column="3" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="বর্তমান দাগ" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Col 4-6: জমির শ্রেণী (ColSpan 3) -->
                                                <Border Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="3" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="জমির শ্রেণী" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Sub: কৃষি -->
                                                <Border Grid.Row="1" Grid.Column="4" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="কৃষি" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <!-- Sub: অকৃষি -->
                                                <Border Grid.Row="1" Grid.Column="5" BorderBrush="#000000" BorderThickness="0,0,1,1" Padding="2">
                                                    <TextBlock Text="অকৃষি" FontSize="10" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
